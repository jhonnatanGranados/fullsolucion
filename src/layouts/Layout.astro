---
// src/layouts/Layout.astro
import ContactDropdown from '../components/ContactDropdown.astro';

export interface Props {
  title: string;
  description?: string;
}

const {
  title = 'Full Solución | Automatización, Energía e Ingeniería Eléctrica en Guatemala',
  description = 'Empresa guatemalteca especializada en instalaciones eléctricas, paneles solares, automatización industrial, videovigilancia y 16 áreas de servicio técnico. Un solo equipo para cada etapa de tu proyecto.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es-GT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph (para redes sociales) -->
    <meta property="og:title" content="Full Solución | Automatización, Energía e Ingeniería Eléctrica" />
    <meta property="og:description" content="16 áreas de servicio técnico: electricidad, paneles solares, automatización, videovigilancia y más." />
    <meta property="og:url" content="https://fullsolucion.vercel.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_GT" />

    <!-- Datos estructurados para Google -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Full Solución",
      "alternateName": "Full Solución Guatemala",
      "url": "https://fullsolucion.vercel.app/",
      "logo": "https://fullsolucion.vercel.app/favicon.svg",
      "description": "Empresa guatemalteca especializada en instalaciones eléctricas, energías renovables, automatización industrial, videovigilancia y soluciones integrales.",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "GT",
        "addressLocality": "Guatemala"
      },
      "areaServed": {
        "@type": "Country",
        "name": "Guatemala"
      },
      "priceRange": "$$",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Servicios de Full Solución",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Instalaciones eléctricas residenciales e industriales" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Energías renovables y paneles solares" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cableado estructurado y redes" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Videovigilancia" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sonido comercial" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Generadores eléctricos" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Reparación y mantenimiento" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automatización de sistemas industriales" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sistemas prefabricados livianos" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Pintura residencial e industrial" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Estructuras livianas" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Soldadura industrial" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Sistemas de gases" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Perfilería PVC" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Mantenimiento y limpieza" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Desarrollo de software" } }
        ]
      }
    })} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ============================================================
         PALETA INSTITUCIONAL FULL SOLUCIÓN
         ============================================================ */
      :root {
        --fs-primary: #142156;
        --fs-secondary: #152A7D;
        --fs-accent: #107BCD;
        --fs-highlight: #0CBBCC;

        --fs-ink: #14161F;
        --fs-slate: #475569;
        --fs-steel: #6B7488;
        --fs-line: #DDE3EC;
        --fs-paper: #F3F5F8;
        --fs-surface: #FAFBFD;
        --fs-white: #FFFFFF;

        --fs-gradient-brand: linear-gradient(
          90deg,
          #142156 0%,
          #152A7D 35%,
          #107BCD 70%,
          #0CBBCC 100%
        );
        --fs-gradient-accent: linear-gradient(135deg, #0CBBCC, #107BCD);
        --fs-gradient-soft: linear-gradient(180deg, #FAFBFD 0%, #F0F3F7 100%);

        --fs-shadow-sm: 0 1px 2px rgba(20, 22, 31, 0.04);
        --fs-shadow-md: 0 8px 24px -16px rgba(20, 33, 86, 0.14);
        --fs-shadow-lg: 0 20px 40px -20px rgba(20, 33, 86, 0.22);
        --fs-shadow-glow: 0 12px 24px -12px rgba(12, 187, 204, 0.45);

        --font-display: 'Space Grotesk', sans-serif;
        --font-body: 'IBM Plex Sans', sans-serif;
        --font-mono: 'IBM Plex Mono', monospace;

        --radius-sm: 4px;
        --radius-md: 10px;
        --radius-lg: 16px;
      }

      /* ============================================================
         RESET Y BASE
         ============================================================ */
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
      }

      body {
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.65;
        color: var(--fs-ink);
        background: var(--fs-white);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      img,
      video {
        max-width: 100%;
        display: block;
      }

      svg {
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font-family: inherit;
      }

      ::selection {
        background: var(--fs-highlight);
        color: var(--fs-primary);
      }

      main {
        display: block;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      section {
        padding: 5rem 0;
      }

      .display {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.4rem, 4.6vw, 3.8rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
        color: var(--fs-primary);
      }

      .section-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.8rem, 2.8vw, 2.4rem);
        line-height: 1.15;
        letter-spacing: -0.015em;
        color: var(--fs-primary);
        text-align: center;
        margin-bottom: 0.75rem;
      }

      .section-title::after {
        content: '';
        display: block;
        width: 56px;
        height: 3px;
        margin: 1rem auto 0;
        border-radius: 2px;
        background: var(--fs-gradient-accent);
      }

      .section-subtitle {
        text-align: center;
        color: var(--fs-steel);
        font-size: 1.075rem;
        line-height: 1.65;
        max-width: 620px;
        margin: 1rem auto 3rem;
      }

      .eyebrow {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--fs-accent);
        margin-bottom: 0.75rem;
      }

      /* ============================================================
         BOTONES GLOBALES
         ============================================================ */
      .btn-primary,
      .btn-secondary,
      .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.01em;
        padding: 0.85rem 2rem;
        border-radius: var(--radius-sm);
        cursor: pointer;
        text-decoration: none;
        border: 2px solid transparent;
        transition:
          background 0.25s ease,
          color 0.25s ease,
          border-color 0.25s ease,
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      .btn-primary {
        background: var(--fs-highlight);
        color: var(--fs-primary);
        border-color: var(--fs-highlight);
      }

      .btn-primary:hover {
        background: var(--fs-white);
        color: var(--fs-primary);
        border-color: var(--fs-highlight);
        transform: translateY(-2px);
        box-shadow: var(--fs-shadow-glow);
      }

      .btn-secondary {
        background: transparent;
        color: var(--fs-primary);
        border-color: var(--fs-primary);
      }

      .btn-secondary:hover {
        background: var(--fs-primary);
        color: var(--fs-white);
      }

      .btn-ghost {
        background: transparent;
        color: var(--fs-white);
        border-color: rgba(255, 255, 255, 0.4);
      }

      .btn-ghost:hover {
        border-color: var(--fs-highlight);
        color: var(--fs-highlight);
        background: rgba(12, 187, 204, 0.08);
      }

      .bg-paper { background: var(--fs-paper); }
      .bg-surface { background: var(--fs-surface); }
      .bg-primary {
        background: var(--fs-primary);
        color: var(--fs-white);
      }

      .top-accent {
        height: 4px;
        width: 100%;
        background: var(--fs-gradient-brand);
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
      }

      :focus-visible {
        outline: 2px solid var(--fs-highlight);
        outline-offset: 3px;
        border-radius: 2px;
      }

      ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }

      ::-webkit-scrollbar-track {
        background: var(--fs-paper);
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, var(--fs-accent), var(--fs-highlight));
        border-radius: 10px;
        border: 2px solid var(--fs-paper);
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--fs-primary);
      }

      @media (max-width: 1024px) {
        section { padding: 4rem 0; }
      }

      @media (max-width: 768px) {
        .grid-3,
        .grid-2 { grid-template-columns: 1fr; }
        section { padding: 3rem 0; }
        .container { padding: 0 1.25rem; }
        .section-title::after { width: 44px; }
      }

      @media (max-width: 480px) {
        body { font-size: 15px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    <ContactDropdown />

    <script>
      import { initHeroCarousel } from '../scripts/hero-carousel';
      import { initContactDropdowns } from '../scripts/contact-dropdown';
      import { initCardTilt } from '../scripts/card-tilt';

      initHeroCarousel();
      initContactDropdowns();
      initCardTilt();
    </script>
  </body>
</html>