        scroll-padding-top: 72px;
      }

      body {
        font-family: var(--font-body);
        font-size: 16px;
        line-height: 1.65;
        color: var(--fs-ink);
        background: var(--fs-white);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      img,
      video {
        max-width: 100%;
        display: block;
      }

      svg {
        max-width: 100%;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font-family: inherit;
      }

      ::selection {
        background: var(--fs-highlight);
        color: var(--fs-primary);
      }

      main {
        display: block;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      section {
        padding: 5rem 0;
      }

      .display {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(2.4rem, 4.6vw, 3.8rem);
        line-height: 1.08;
        letter-spacing: -0.02em;
        color: var(--fs-primary);
      }

      .section-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: clamp(1.8rem, 2.8vw, 2.4rem);
        line-height: 1.15;
        letter-spacing: -0.015em;
        color: var(--fs-primary);
        text-align: center;
        margin-bottom: 0.75rem;
      }

      .section-title::after {
        content: '';
        display: block;
        width: 56px;
        height: 3px;
        margin: 1rem auto 0;
        border-radius: 2px;
        background: var(--fs-gradient-accent);
      }

      .section-subtitle {
        text-align: center;
        color: var(--fs-steel);
        font-size: 1.075rem;
        line-height: 1.65;
        max-width: 620px;
        margin: 1rem auto 3rem;
      }

      .eyebrow {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--fs-accent);
        margin-bottom: 0.75rem;
      }

      .btn-primary,
      .btn-secondary,
      .btn-ghost {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.95rem;
        letter-spacing: 0.01em;
        padding: 0.85rem 2rem;
        border-radius: var(--radius-sm);
        cursor: pointer;
        text-decoration: none;
        border: 2px solid transparent;
        transition:
          background 0.25s ease,
          color 0.25s ease,
          border-color 0.25s ease,
          transform 0.25s ease,
          box-shadow 0.25s ease;
      }

      .btn-primary {
        background: var(--fs-highlight);
        color: var(--fs-primary);
        border-color: var(--fs-highlight);
      }

      .btn-primary:hover {
        background: var(--fs-white);
        color: var(--fs-primary);
        border-color: var(--fs-highlight);
        transform: translateY(-2px);
        box-shadow: var(--fs-shadow-glow);
      }

      .btn-secondary {
        background: transparent;
        color: var(--fs-primary);
        border-color: var(--fs-primary);
      }

      .btn-secondary:hover {
        background: var(--fs-primary);
        color: var(--fs-white);
      }

      .btn-ghost {
        background: transparent;
        color: var(--fs-white);
        border-color: rgba(255, 255, 255, 0.4);
      }

      .btn-ghost:hover {
        border-color: var(--fs-highlight);
        color: var(--fs-highlight);
        background: rgba(12, 187, 204, 0.08);
      }

      .bg-paper { background: var(--fs-paper); }
      .bg-surface { background: var(--fs-surface); }
      .bg-primary {
        background: var(--fs-primary);
        color: var(--fs-white);
      }

      .top-accent {
        height: 4px;
        width: 100%;
        background: var(--fs-gradient-brand);
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 2rem;
      }

      :focus-visible {
        outline: 2px solid var(--fs-highlight);
        outline-offset: 3px;
        border-radius: 2px;
      }

      ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
      }

      ::-webkit-scrollbar-track {
        background: var(--fs-paper);
      }

      ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, var(--fs-accent), var(--fs-highlight));
        border-radius: 10px;
        border: 2px solid var(--fs-paper);
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--fs-primary);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      @media (max-width: 1024px) {
        section { padding: 4rem 0; }
      }

      @media (max-width: 768px) {
        .grid-3,
        .grid-2 { grid-template-columns: 1fr; }
        section { padding: 3rem 0; }
        .container { padding: 0 1.25rem; }
        .section-title::after { width: 44px; }
