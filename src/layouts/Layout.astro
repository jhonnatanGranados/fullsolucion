---
// src/layouts/Layout.astro
import ContactDropdown from '../components/ContactDropdown.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

const {
  title = 'Servicios Eléctricos y Automatización en Guatemala y Huehuetenango | Full Solución',
  description = 'Empresa guatemalteca especializada en instalaciones eléctricas, paneles solares, automatización industrial, videovigilancia y 16 áreas de servicio técnico en Guatemala y Huehuetenango.',
  image = '/logo.png',
  canonical = Astro.url.pathname,
} = Astro.props;

const siteUrl = 'https://fullsolucion.vercel.app';
const canonicalURL = new URL(canonical, siteUrl);
const ogImage = new URL(image, siteUrl);

const telefono = '+502 4108 0263';
const email = 'fullsolution001@gmail.com';

const ubicacion = {
  latitud: 15.3197,
  longitud: -91.4708,
  ciudad: 'Huehuetenango',
  region: 'Huehuetenango',
  pais: 'GT',
};

const serviciosCatalogo = [
  { slug: 'electricidad-general', nombre: 'Instalaciones eléctricas residenciales e industriales en Guatemala' },
  { slug: 'energias-renovables', nombre: 'Energías renovables y paneles solares en Guatemala y Huehuetenango' },
  { slug: 'cableado-estructurado', nombre: 'Cableado estructurado y redes' },
  { slug: 'videovigilancia', nombre: 'Videovigilancia y cámaras de seguridad' },
  { slug: 'sonido-comercial', nombre: 'Sonido comercial' },
  { slug: 'generadores-electricos', nombre: 'Generadores eléctricos' },
  { slug: 'reparacion-mantenimiento', nombre: 'Reparación y mantenimiento eléctrico' },
  { slug: 'automatizacion-industrial', nombre: 'Automatización de sistemas industriales en Guatemala y Huehuetenango' },
  { slug: 'sistemas-prefabricados', nombre: 'Sistemas prefabricados livianos' },
  { slug: 'pintura', nombre: 'Pintura residencial e industrial' },
  { slug: 'estructuras-livianas', nombre: 'Estructuras livianas' },
  { slug: 'soldadura-industrial', nombre: 'Soldadura industrial' },
  { slug: 'sistemas-de-gases', nombre: 'Sistemas de gases' },
  { slug: 'perfileria-pvc', nombre: 'Perfilería PVC' },
  { slug: 'mantenimiento-limpieza', nombre: 'Mantenimiento y limpieza' },
  { slug: 'desarrollo-software', nombre: 'Desarrollo de software' },
];

const orgId = `${siteUrl}/#organizacion`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ElectricalContractor',
      '@id': orgId,
      name: 'Full Solución',
      alternateName: 'Full Solución Guatemala',
      url: siteUrl,
      logo: `${siteUrl}/logo.png`,
      image: ogImage.href,
      description:
        'Empresa guatemalteca especializada en instalaciones eléctricas, energías renovables, automatización industrial, videovigilancia y soluciones integrales en Guatemala y Huehuetenango.',
      telephone: telefono,
      email,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressCountry: ubicacion.pais,
        addressRegion: ubicacion.region,
        addressLocality: ubicacion.ciudad,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: ubicacion.latitud,
        longitude: ubicacion.longitud,
      },
      areaServed: [
        { '@type': 'Country', name: 'Guatemala' },
        { '@type': 'City', name: 'Guatemala' },
        { '@type': 'City', name: 'Huehuetenango' },
        { '@type': 'City', name: 'Quetzaltenango' },
        { '@type': 'City', name: 'Chimaltenango' },
      ],
      knowsLanguage: ['es-GT', 'es'],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '18:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday'],
          opens: '08:00',
          closes: '13:00',
        },
      ],
      sameAs: [
        'https://www.facebook.com/people/Fullsolution-Gt/pfbid031XL1kRyrCVpH1ccsTbyDk9gNrCxADrns4UfuZxaVeVqEFwdcAwXo94okCHRpw6AHl/',
        'https://www.instagram.com/fullsolution_gt/',
        'https://www.tiktok.com/@full.solution_gt',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios de Full Solución',
        itemListElement: serviciosCatalogo.map((s) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: s.nombre,
            url: `${siteUrl}/#${s.slug}`,
          },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Full Solución',
      url: siteUrl,
      inLanguage: 'es-GT',
      publisher: { '@id': orgId },
    },
  ],
};
---

<!doctype html>
<html lang="es-GT">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="geo.region" content="GT-HU" />
    <meta name="geo.placename" content={`${ubicacion.ciudad}, ${ubicacion.region}`} />
    <meta name="geo.position" content={`${ubicacion.latitud};${ubicacion.longitud}`} />
    <meta name="ICBM" content={`${ubicacion.latitud}, ${ubicacion.longitud}`} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Full Solución" />
    <meta property="og:locale" content="es_GT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <ContactDropdown />
    <slot />
  </body>
</html>