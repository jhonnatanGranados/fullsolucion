---
import { Icon } from 'astro-icon/components';

const year = new Date().getFullYear();

const contacto = {
  telefono: '+502 4108 0263',
  telefonoLink: 'tel:+50241080263',
  whatsapp: 'https://wa.me/50241080263',
  correo: 'fullsolution001@gmail.com',
  correoLink: 'mailto:fullsolution001@gmail.com',
  instagram: 'https://www.instagram.com/fullsolution_gt/',
  facebook:
    'https://www.facebook.com/people/Fullsolution-Gt/pfbid031XL1kRyrCVpH1ccsTbyDk9gNrCxADrns4UfuZxaVeVqEFwdcAwXo94okCHRpw6AHl/?mibextid=wwXIfr&rdid=apzeCE2AfHgr4zBv&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F19SU23Fyac%2F%3Fmibextid%3DwwXIfr',
  tiktok: 'https://www.tiktok.com/@full.solution_gt?_r=1&_t=ZS-99vHFqEJWR2',
};

const social = [
  {
    label: 'WhatsApp',
    href: contacto.whatsapp,
    external: true,
    className: 'whatsapp',
    icon: 'simple-icons:whatsapp',
  },
  {
    label: 'Facebook',
    href: contacto.facebook,
    external: true,
    className: 'facebook',
    icon: 'simple-icons:facebook',
  },
  {
    label: 'Instagram',
    href: contacto.instagram,
    external: true,
    className: 'instagram',
    icon: 'simple-icons:instagram',
  },
  {
    label: 'TikTok',
    href: contacto.tiktok,
    external: true,
    className: 'tiktok',
    icon: 'simple-icons:tiktok',
  },
  {
    label: 'Correo',
    href: contacto.correoLink,
    external: false,
    className: 'correo',
    icon: 'mdi:email-outline',
  },
];

const contactRows = [
  {
    label: contacto.telefono,
    href: contacto.telefonoLink,
    external: false,
    itemprop: 'telephone',
    icon: 'mdi:phone',
  },
  {
    label: 'WhatsApp',
    href: contacto.whatsapp,
    external: true,
    itemprop: 'telephone',
    icon: 'simple-icons:whatsapp',
  },
  {
    label: contacto.correo,
    href: contacto.correoLink,
    external: false,
    itemprop: 'email',
    icon: 'mdi:email-outline',
  },
  {
    label: 'Facebook',
    href: contacto.facebook,
    external: true,
    itemprop: 'sameAs',
    icon: 'simple-icons:facebook',
  },
  {
    label: 'Instagram',
    href: contacto.instagram,
    external: true,
    itemprop: 'sameAs',
    icon: 'simple-icons:instagram',
  },
  {
    label: 'TikTok',
    href: contacto.tiktok,
    external: true,
    itemprop: 'sameAs',
    icon: 'simple-icons:tiktok',
  },
];
---

<footer class="footer">
  <div class="footer__inner">

    <div class="footer__col footer__col--brand">
      <h3 class="footer__brand">
        <span class="footer__brand-mark"></span>
        Full Solución
      </h3>

      <p class="footer__tagline">
        Full Solución es tu equipo técnico en Guatemala para automatización,
        energía e ingeniería eléctrica. Damos forma y vida a tus proyectos.
      </p>

      <address class="footer__address">
        Huehuetenango, Guatemala<br />
        Cobertura en toda Guatemala
      </address>

      <div class="footer__social">
        {social.map((s) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
            class={`footer__social-link footer__social-link--${s.className}`}
            aria-label={s.label}
            title={s.label}
          >
            <Icon name={s.icon} width={20} height={20} aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>

    <div class="footer__col">
      <h4 class="footer__title">Enlaces</h4>

      <ul class="footer__list">
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="footer__title">Contacto</h4>

      <ul class="footer__list footer__list--contact">
        {contactRows.map((c) => (
          <li itemscope itemtype="https://schema.org/ContactPoint">
            <span class="footer__ico" aria-hidden="true">
              <Icon name={c.icon} width={18} height={18} />
            </span>

            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              itemprop={c.itemprop}
            >
              {c.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <div class="footer__bottom">
    <span>
      &copy; {year} Full Solución. Todos los derechos reservados.
    </span>

    <span class="footer__made">
      Servicio Técnico Eléctrico — Huehuetenango, Guatemala
    </span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    /* Degradado más suave y profundo */
    background: linear-gradient(180deg, #0f2a3f 0%, #0a1f30 60%, #071826 100%);
    color: #e8f4f8; /* Blanco humo más luminoso */
    margin-top: 4rem;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      #0f2a3f 0%,
      #2d7d9a 35%,
      #5fd0d6 70%,
      #8ee5ea 100%
    );
  }

  /* Halo decorativo de fondo - más sutil */
  .footer::after {
    content: '';
    position: absolute;
    top: -120px;
    right: -120px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(95, 208, 214, 0.06) 0%,
      rgba(95, 208, 214, 0) 70%
    );
    pointer-events: none;
  }

  .footer__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 4rem clamp(1.5rem, 5vw, 5rem) 3rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }

  .footer__col--brand {
    max-width: 360px;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    letter-spacing: 0.01em;
  }

  .footer__brand-mark {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, #5fd0d6, #8ee5ea);
    box-shadow: 0 0 12px rgba(95, 208, 214, 0.5);
  }

  .footer__tagline {
    color: #c5dde6; /* Más claro para legibilidad */
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .footer__address {
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #c5dde6; /* Más claro */
    margin-bottom: 1.25rem;
  }

  /* ------- Redes sociales ------- */
  .footer__social {
    display: flex;
    gap: 0.7rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff; /* Blanco puro para iconos sociales */
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .footer__social-link svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
    fill: currentColor;
    stroke: none;
  }

  .footer__social-link--whatsapp:hover {
    background: #25d366;
    border-color: #25d366;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(37, 211, 102, 0.35);
  }

  .footer__social-link--facebook:hover {
    background: #1877f2;
    border-color: #1877f2;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(24, 119, 242, 0.35);
  }

  .footer__social-link--instagram:hover {
    background: #e1306c;
    border-color: #e1306c;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(225, 48, 108, 0.35);
  }

  .footer__social-link--tiktok:hover {
    background: #111111;
    border-color: #111111;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5);
  }

  .footer__social-link--correo:hover {
    background: #5fd0d6;
    border-color: #5fd0d6;
    color: #0a1f30;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(95, 208, 214, 0.4);
  }

  /* ------- Columnas ------- */
  .footer__title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1.1rem;
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer__list li {
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .footer__list a {
    color: #e8f4f8; 
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__list a:hover {
    color: #8ee5ea;
  }

  /* Contacto: texto e iconos en blanco puro */
  .footer__list--contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer__list--contact a {
    color: #ffffff; /* Blanco puro para los enlaces de contacto */
  }

  .footer__list--contact a:hover {
    color: #8ee5ea;
  }

  /* ------- Iconos de contacto ------- */
  .footer__ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    color: #ffffff; /* Blanco puro para los iconos de contacto */
    flex-shrink: 0;
  }

  .footer__ico svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
    stroke: none;
  }

  /* ------- Pie inferior ------- */
  .footer__bottom {
    max-width: 1160px;
    margin: 0 auto;
    padding: 1.5rem clamp(1.5rem, 5vw, 5rem);
    border-top: 1px solid rgba(95, 208, 214, 0.15);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.85rem;
    color: #c5dde6; /* Más claro para legibilidad */
    position: relative;
    z-index: 1;
  }

  .footer__made {
    color: #8ee5ea; /* Un tono más claro que el cian original */
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__col--brand {
      grid-column: 1 / -1;
      max-width: 100%;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 1.25rem 2rem;
    }

    .footer__bottom {
      flex-direction: column;
      text-align: center;
      padding: 1.25rem;
    }
  }
</style>