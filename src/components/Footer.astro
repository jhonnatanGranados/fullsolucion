---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__col footer__col--brand">
      <h3 class="footer__brand">
        <span class="footer__brand-mark"></span>Full Solución
      </h3>
      <p class="footer__tagline">
        Full Solución es tu equipo técnico en Guatemala para automatización, energía e
        ingeniería eléctrica. Damos forma y vida a tus proyectos.
      </p>

      <div class="footer__social">
        {social.map((s) => (
          <a
            href={s.href}
            target={s.external ? '_blank' : undefined}
            rel={s.external ? 'noopener noreferrer' : undefined}
            class="footer__social-link"
            aria-label={s.label}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={s.path}
            />
          </a>
        ))}
      </div>
    </div>

    <div class="footer__col">
      <h4 class="footer__title">Enlaces</h4>
      <ul class="footer__list">
        <li><a href="#inicio">Inicio</a></li>
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h4 class="footer__title">Contacto</h4>
      <ul class="footer__list footer__list--contact">
        {contactRows.map((c) => (
          <li>
            <span class="footer__ico" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={c.path}
              />
            </span>
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
            >
              {c.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <span>&copy; {year} Full Solución. Todos los derechos reservados.</span>
    <span class="footer__made">Servicio Técnico Industrial — Guatemala</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--fs-primary);
    color: rgba(255, 255, 255, 0.78);
    margin-top: 4rem;
    overflow: hidden;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--fs-primary) 0%,
      var(--fs-secondary) 35%,
      var(--fs-accent) 70%,
      var(--fs-highlight) 100%
    );
  }

  .footer::after {
    content: '';
    position: absolute;
    top: -120px;
    right: -120px;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(12, 187, 204, 0.18) 0%,
      rgba(12, 187, 204, 0) 70%
    );
    pointer-events: none;
  }

  .footer__inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 4rem clamp(1.5rem, 5vw, 5rem) 3rem;
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr;
    gap: 3rem;
    position: relative;
    z-index: 1;
  }

  .footer__col--brand {
    max-width: 360px;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--fs-white);
    margin-bottom: 1rem;
  }

  .footer__brand-mark {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--fs-accent), var(--fs-highlight));
  }

  .footer__tagline {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.92rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .footer__social {
    display: flex;
    gap: 0.7rem;
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--fs-white);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .footer__social-link svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .footer__social-link:hover {
    background: var(--fs-highlight);
    color: var(--fs-primary);
    transform: translateY(-2px);
    border-color: var(--fs-highlight);
  }

  .footer__title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fs-white);
    margin-bottom: 1.1rem;
  }

  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer__list li {
    font-size: 0.9rem;
  }

  .footer__list a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__list a:hover {
    color: var(--fs-highlight);
  }

  .footer__list--contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer__ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    color: var(--fs-highlight);
  }

  .footer__ico svg {
    width: 100%;
    height: 100%;
  }

  .footer__bottom {
    max-width: 1160px;
    margin: 0 auto;
    padding: 1.5rem clamp(1.5rem, 5vw, 5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    position: relative;
    z-index: 1;
  }

  .footer__made {
    color: var(--fs-highlight);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.03em;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer__col--brand {
      grid-column: 1 / -1;
      max-width: 100%;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 1.25rem 2rem;
    }
    .footer__bottom {
      flex-direction: column;
      text-align: center;
      padding: 1.25rem;
    }
  }
</style>