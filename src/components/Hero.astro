---
// src/components/Hero.astro

import portada  from '../assets/portada.jpg';
import logo     from '../assets/logo.png';
import imagen2  from '../assets/imagen2.webp';
import imagen3  from '../assets/imagen3.webp';
import imagen4  from '../assets/imagen4.webp';
import imagen5  from '../assets/imagen5.webp';
import imagen6  from '../assets/imagen6.webp';
import imagen7  from '../assets/imagen7.webp';
import imagen8  from '../assets/imagen8.webp';
import imagen9  from '../assets/imagen9.webp';
import imagen10 from '../assets/imagen10.webp';
import imagen11 from '../assets/imagen11.webp';

import c2_img1 from '../assets/Caruzel2/imagen1_11zon.webp';
import c2_img2 from '../assets/Caruzel2/imagen2_11zon.webp';
import c2_img3 from '../assets/Caruzel2/imagen3_11zon.webp';
import c2_img4 from '../assets/Caruzel2/imagen4_11zon.webp';
import c2_img5 from '../assets/Caruzel2/imagen5_11zon.webp';
import c2_img6 from '../assets/Caruzel2/imagen6_11zon.webp';

const heroImages = [
  { src: portada.src,  alt: 'Proyecto eléctrico residencial en Guatemala ejecutado por Full Solución' },
  { src: imagen2.src,  alt: 'Instalación eléctrica industrial en Huehuetenango por Full Solución' },
  { src: imagen3.src,  alt: 'Panel solar instalado por Full Solución en Guatemala' },
  { src: imagen4.src,  alt: 'Automatización industrial ejecutada por Full Solución en Guatemala' },
  { src: imagen5.src,  alt: 'Sistema de videovigilancia instalado en Guatemala por Full Solución' },
  { src: imagen6.src,  alt: 'Trabajo de cableado estructurado en Huehuetenango por Full Solución' },
  { src: imagen7.src,  alt: 'Mantenimiento eléctrico industrial en Guatemala por Full Solución' },
  { src: imagen8.src,  alt: 'Instalación de generador eléctrico en Guatemala por Full Solución' },
  { src: imagen9.src,  alt: 'Proyecto de construcción liviana en Huehuetenango por Full Solución' },
  { src: imagen10.src, alt: 'Estructura metálica liviana instalada por Full Solución en Guatemala' },
  { src: imagen11.src, alt: 'Proyecto de soldadura industrial en Guatemala por Full Solución' },
];

const carrusel2Images = [
  { src: c2_img1.src, alt: 'Equipo Full Solución en proyecto 1' },
  { src: c2_img2.src, alt: 'Equipo Full Solución en proyecto 2' },
  { src: c2_img3.src, alt: 'Equipo Full Solución en proyecto 3' },
  { src: c2_img4.src, alt: 'Equipo Full Solución en proyecto 4' },
  { src: c2_img5.src, alt: 'Equipo Full Solución en proyecto 5' },
  { src: c2_img6.src, alt: 'Equipo Full Solución en proyecto 6' },
];
---

<section
  id="inicio"
  class="hero"
  data-interval="6000"
  aria-label="Full Solución — Instalaciones eléctricas, tierras físicas, automatización y energías renovables en Guatemala y Huehuetenango"
>

  <div class="hero__grid">

    <div class="hero__carousel-main">
      <div class="hero__carousel" data-carousel="main">
        {heroImages.map((img, i) => (
          <div
            class="hero__slide"
            data-active={i === 0 ? 'true' : 'false'}
          >
            <img
              src={img.src}
              alt={img.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
              width="1200"
              height="800"
            />
          </div>
        ))}
      </div>

      <div class="hero__overlay" aria-hidden="true"></div>

      <div class="hero__content">
        <span class="hero__eyebrow">FULL SOLUCIÓN</span>

        <h1 class="hero__title">
          <span class="hero__title-white">Instalaciones eléctricas y tierras físicas</span>
          <span class="hero__title-blue">automatización y energías renovables</span>
          <span class="hero__title-place">en Huehuetenango y toda Guatemala</span>
        </h1>

        <div class="hero__divider" aria-hidden="true">
          <span class="hero__divider-dot"></span>
          <span class="hero__divider-line"></span>
          <span class="hero__divider-dot"></span>
        </div>

        <p class="hero__lead">
          En <strong>Full Solución</strong> diseñamos, instalamos y mantenemos
          <strong>instalaciones eléctricas</strong>, <strong>sistemas de automatización</strong>,
          <strong>tierras físicas</strong> y <strong>energías renovables</strong> para tu hogar,
          comercio o planta industrial en Guatemala y Huehuetenango.
          16 servicios, un solo equipo técnico.
        </p>

        <button
          type="button"
          class="hero__cta"
          data-scroll-to="servicios"
          aria-label="Ir a la sección de servicios"
        >CONOCE MÁS</button>
      </div>
    </div>

    <div class="hero__carousel-right">
      <div class="hero__carousel" data-carousel="side">
        {carrusel2Images.map((img, i) => (
          <div
            class="hero__slide"
            data-active={i === 0 ? 'true' : 'false'}
          >
            <img
              src={img.src}
              alt={img.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
              width="1600"
              height="900"
            />
          </div>
        ))}
      </div>

      <div class="hero__logo-cove" aria-hidden="true">
        <img
          src={logo.src}
          alt=""
          width="72"
          height="72"
          decoding="async"
          draggable="false"
        />
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    width: calc(100% - 6rem);
    max-width: 1400px;
    margin: 2.5rem auto 6rem;
    aspect-ratio: 16 / 7.2;
    max-height: 78vh;
    min-height: 460px;
    overflow: hidden;
    background: #0A1A3A;
    isolation: isolate;
    border-radius: 10px;
    box-shadow: 0 24px 70px -35px rgba(0, 0, 0, 0.55);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 38% 62%;
    gap: 0;
  }

  .hero__carousel-main,
  .hero__carousel-right {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0f1823;
    min-height: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      180deg,
      rgba(10, 26, 58, 0.10) 0%,
      rgba(10, 26, 58, 0.45) 45%,
      rgba(10, 26, 58, 0.88) 100%
    );
    pointer-events: none;
  }

  .hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.75rem;
    padding: 2.2rem 2rem 2.4rem;
    max-width: 100%;
  }

  .hero__eyebrow {
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #4FC3FF;
  }

  .hero__title {
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 900;
    font-size: clamp(1.2rem, 1.9vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 0;
    text-transform: uppercase;
  }
  .hero__title-white { color: #ffffff; display: block; }
  .hero__title-blue  { color: #4FC3FF; display: block; margin-top: 0.12em; }
  .hero__title-place {
    color: #ffffff;
    display: block;
    margin-top: 0.12em;
    font-size: 0.85em;
    font-weight: 700;
    letter-spacing: 0.01em;
    opacity: 0.92;
  }

  .hero__divider { display: flex; align-items: center; gap: 0.6rem; width: 100%; max-width: 220px; margin-top: 0.1rem; }
  .hero__divider-line { flex: 1; height: 1px; background: rgba(255,255,255,0.55); }
  .hero__divider-dot  { width: 5px; height: 5px; border-radius: 50%; background: #ffffff; }

  .hero__lead {
    font-size: clamp(0.8rem, 0.92vw, 0.95rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    max-width: 46ch;
  }
  .hero__lead strong { color: #ffffff; font-weight: 700; }

  .hero__cta {
    position: relative;
    display: inline-block;
    margin: 0.5rem 0 0;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    width: auto;
    min-width: 150px;
    padding: 0.7rem 1.5rem;
    background-color: #0A4BD3;
    border: 1px solid #0A4BD3;
    border-radius: 999px;
    color: #ffffff;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    box-shadow: 0 3px 9px -3px rgba(10, 75, 211, 0.55), 0 9px 20px -10px rgba(10, 75, 211, 0.6);
    transition: background-color 0.35s ease, border-color 0.35s ease, transform 0.3s ease, box-shadow 0.35s ease;
  }
  .hero__cta::before {
    content: ''; position: absolute; top: 0; left: -120%; width: 60%; height: 100%;
    background: linear-gradient(120deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 100%);
    transform: skewX(-20deg); transition: left 0.7s cubic-bezier(0.22,1,0.36,1);
    pointer-events: none; z-index: 1;
  }
  .hero__cta:hover::before { left: 130%; }
  .hero__cta:hover {
    background-color: #0c5eef;
    border-color: #0c5eef;
    transform: translateY(-2px);
    box-shadow: 0 5px 12px -5px rgba(10,75,211,0.35), 0 14px 30px -14px rgba(10,75,211,0.55);
  }
  .hero__cta:active { transform: translateY(0) scale(0.98); }

  .hero__carousel {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0f1823;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #0f1823;
    opacity: 0;
    visibility: hidden;
    z-index: 0;
    transform: scale(1.08);
    transition:
      opacity 1400ms cubic-bezier(0.45, 0.05, 0.55, 0.95),
      transform 1800ms cubic-bezier(0.45, 0.05, 0.55, 0.95),
      visibility 0s linear 1800ms;
    will-change: opacity, transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__slide[data-active='true'] {
    opacity: 1;
    visibility: visible;
    z-index: 1;
    transform: scale(1);
    pointer-events: auto;
    transition:
      opacity 1400ms cubic-bezier(0.45, 0.05, 0.55, 0.95),
      transform 1800ms cubic-bezier(0.45, 0.05, 0.55, 0.95),
      visibility 0s linear 0s;
  }

  .hero__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    user-select: none;
    -webkit-user-drag: none;
    filter: saturate(0.95) brightness(0.96) contrast(1.05);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* ================================
     LOGO COVE — esquina tipo ola donde reposa el logo
     ================================ */
  .hero__logo-cove {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: clamp(14px, 2vw, 24px) clamp(14px, 2vw, 24px) clamp(14px, 2vw, 24px) clamp(28px, 4vw, 48px);
    border-top-left-radius: 100% 100%;
    border-bottom-left-radius: 0;
    background: linear-gradient(
      135deg,
      rgba(10, 26, 58, 0) 0%,
      rgba(10, 26, 58, 0.45) 40%,
      rgba(10, 26, 58, 0.75) 100%
    );
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    pointer-events: none;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__logo-cove::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(79, 195, 255, 0) 0%,
      rgba(79, 195, 255, 0.45) 50%,
      rgba(79, 195, 255, 0.8) 100%
    );
    pointer-events: none;
  }

  .hero__logo-cove::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 60%;
    background: radial-gradient(
      circle at 100% 0%,
      rgba(79, 195, 255, 0.22) 0%,
      rgba(79, 195, 255, 0) 70%
    );
    pointer-events: none;
  }

  .hero__logo-cove img {
    position: relative;
    z-index: 2;
    display: block;
    width: clamp(52px, 5vw, 76px);
    height: auto;
    max-height: 76px;
    object-fit: contain;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.55));
  }

  @media (max-width: 1280px) {
    .hero {
      width: calc(100% - 4rem);
      margin: 2rem auto 5rem;
    }
    .hero__title { font-size: clamp(1.1rem, 1.7vw, 1.8rem); }
    .hero__eyebrow { font-size: 0.8rem; }
    .hero__lead { font-size: clamp(0.78rem, 0.88vw, 0.9rem); }
    .hero__content { padding: 1.8rem 1.8rem 2rem; gap: 0.65rem; }
    .hero__cta { font-size: 0.78rem; padding: 0.65rem 1.4rem; min-width: 140px; }
  }

  @media (max-width: 1100px) {
    .hero__title { font-size: clamp(1rem, 1.5vw, 1.5rem); }
    .hero__content { padding: 1.6rem 1.6rem 1.8rem; gap: 0.6rem; }
    .hero__eyebrow { font-size: 0.74rem; }
    .hero__lead { font-size: 0.82rem; }
    .hero__cta { font-size: 0.74rem; padding: 0.6rem 1.25rem; min-width: 130px; }
  }

  @media (max-width: 900px) {
    .hero {
      width: 100%;
      max-width: 100%;
      margin: 0;
      aspect-ratio: auto;
      min-height: 100svh;
      max-height: none;
      display: block;
      background: #000000;
      overflow: hidden;
      position: relative;
      border-radius: 0;
      box-shadow: none;
    }

    .hero__grid {
      position: static;
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 100svh;
      padding: 0;
      gap: 0;
    }

    .hero__carousel-main {
      position: relative;
      width: 100%;
      flex: 1 1 100%;
      min-height: 100svh;
      display: block;
      overflow: hidden;
      background: #000000;
    }

    .hero__carousel-right {
      display: none;
    }

    .hero__carousel {
      background: #000000;
      width: 100%;
      height: 100%;
      position: absolute;
      inset: 0;
    }

    .hero__slide {
      justify-content: center;
      align-items: center;
      background: #000000;
    }

    .hero__slide img {
      object-fit: cover;
      object-position: center center;
      width: 100%;
      height: 100%;
    }

    .hero__overlay {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 5;
      background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.15) 0%,
        rgba(0, 0, 0, 0.45) 50%,
        rgba(0, 0, 0, 0.85) 100%
      );
      pointer-events: none;
    }

    .hero__content {
      position: absolute;
      left: 50%;
      bottom: 8%;
      transform: translateX(-50%);
      top: auto;
      width: min(90%, 520px);
      max-width: 520px;
      padding: 1.3rem 1.2rem 1.4rem;
      align-items: center;
      text-align: center;
      gap: 0.6rem;
      z-index: 10;
      background: rgba(30, 37, 48, 0.55);
      backdrop-filter: blur(10px) saturate(1.1);
      -webkit-backdrop-filter: blur(10px) saturate(1.1);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 16px;
      box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.65),
                  inset 0 1px 0 rgba(255, 255, 255, 0.18);
    }

    .hero__eyebrow { font-size: 0.72rem; letter-spacing: 0.14em; }
    .hero__title   { font-size: clamp(1.05rem, 4.6vw, 1.5rem); text-align: center; }
    .hero__title-white, .hero__title-blue, .hero__title-place { display: block; }
    .hero__lead    { font-size: 0.82rem; max-width: 50ch; }
    .hero__divider { max-width: 180px; }
    .hero__cta     { font-size: 0.74rem; padding: 0.6rem 1.3rem; min-width: 130px; }

    .hero__logo-cove { display: none; }
  }

  @media (max-width: 560px) {
    .hero__carousel-main  { min-height: 100svh; flex: 1 1 100%; }

    .hero__content {
      bottom: 6%;
      padding: 1.1rem 0.95rem 1.25rem;
      border-radius: 14px;
      gap: 0.5rem;
    }
    .hero__eyebrow { font-size: 0.68rem; }
    .hero__title   { font-size: clamp(0.95rem, 4.4vw, 1.3rem); }
    .hero__lead    { font-size: 0.78rem; }
    .hero__cta     { font-size: 0.7rem; padding: 0.55rem 1.2rem; min-width: 120px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__slide,
    .hero__slide[data-active='true'] {
      transition:
        opacity 400ms ease,
        visibility 0s linear 400ms;
      transform: none !important;
    }
    .hero__slide[data-active='true'] {
      transition:
        opacity 400ms ease,
        visibility 0s linear 0s;
    }
  }
</style>

<script>
  function initHeroCarousels() {
    document.querySelectorAll<HTMLElement>('.hero').forEach((hero) => {
      if (hero.dataset.carouselInit) return;
      hero.dataset.carouselInit = 'true';

      const interval = Number(hero.dataset.interval ?? 6000);
      const carousels = hero.querySelectorAll<HTMLElement>('.hero__carousel');

      const controllers: Array<{ start: () => void; stop: () => void }> = [];

      carousels.forEach((carousel, idx) => {
        const slides = carousel.querySelectorAll<HTMLElement>('.hero__slide');
        if (slides.length < 2) return;

        let current = 0;
        let rafId: number | null = null;
        let isPaused = false;
        let nextChangeAt = performance.now() + idx * 1200 + interval;

        slides.forEach((s, i) => {
          s.dataset.active = i === 0 ? 'true' : 'false';
        });

        const nextSlide = () => {
          slides[current].dataset.active = 'false';
          current = (current + 1) % slides.length;
          slides[current].dataset.active = 'true';
        };

        const tick = (now: number) => {
          if (!isPaused && now >= nextChangeAt) {
            nextSlide();
            nextChangeAt = now + interval;
          }
          rafId = requestAnimationFrame(tick);
        };

        const start = () => {
          if (rafId !== null) return;
          nextChangeAt = performance.now() + interval;
          rafId = requestAnimationFrame(tick);
        };

        const stop = () => {
          if (rafId !== null) {
            cancelAnimationFrame(rafId);
            rafId = null;
          }
        };

        const io = new IntersectionObserver(
          ([entry]) => {
            isPaused = !entry.isIntersecting;
            if (entry.isIntersecting && !document.hidden) start();
            else stop();
          },
          { threshold: 0, rootMargin: '100px' }
        );
        io.observe(carousel);

        start();
        controllers.push({ start, stop });
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          controllers.forEach((c) => c.stop());
        } else {
          controllers.forEach((c) => c.start());
        }
      });

      document.addEventListener('astro:before-swap', () => {
        controllers.forEach((c) => c.stop());
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroCarousels);
  } else {
    initHeroCarousels();
  }
  document.addEventListener('astro:page-load', initHeroCarousels);

  document.querySelectorAll<HTMLElement>('[data-scroll-to]').forEach((btn) => {
    if (btn.dataset.scrollInit) return;
    btn.dataset.scrollInit = 'true';

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = btn.dataset.scrollTo;
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (!target) return;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({
        behavior: prefersReduced ? 'auto' : 'smooth',
        block: 'start',
      });
    });
  });
</script>