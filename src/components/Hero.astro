---
// src/components/Hero.astro

import portada  from '../assets/portada.jpg';
import logo     from '../assets/logo.png';
import imagen2  from '../assets/imagen2.webp';
import imagen3  from '../assets/imagen3.webp';
import imagen4  from '../assets/imagen4.webp';
import imagen5  from '../assets/imagen5.webp';
import imagen6  from '../assets/imagen6.webp';
import imagen7  from '../assets/imagen7.webp';
import imagen8  from '../assets/imagen8.webp';
import imagen9  from '../assets/imagen9.webp';
import imagen10 from '../assets/imagen10.webp';
import imagen11 from '../assets/imagen11.webp';

const heroImages = [
  {
    src: portada.src,
    alt: 'Proyecto eléctrico residencial en Guatemala ejecutado por Full Solución',
    isLogo: false,
  },
  {
    src: imagen2.src,
    alt: 'Instalación eléctrica industrial en Huehuetenango por Full Solución',
    isLogo: false,
  },
  {
    src: imagen3.src,
    alt: 'Panel solar instalado por Full Solución en Guatemala',
    isLogo: false,
  },
  {
    src: imagen4.src,
    alt: 'Automatización industrial ejecutada por Full Solución en Guatemala',
    isLogo: false,
  },
  {
    src: imagen5.src,
    alt: 'Sistema de videovigilancia instalado en Guatemala por Full Solución',
    isLogo: false,
  },
  {
    src: imagen6.src,
    alt: 'Trabajo de cableado estructurado en Huehuetenango por Full Solución',
    isLogo: false,
  },
  {
    src: imagen7.src,
    alt: 'Mantenimiento eléctrico industrial en Guatemala por Full Solución',
    isLogo: false,
  },
  {
    src: imagen8.src,
    alt: 'Instalación de generador eléctrico en Guatemala por Full Solución',
    isLogo: false,
  },
  {
    src: imagen9.src,
    alt: 'Proyecto de construcción liviana en Huehuetenango por Full Solución',
    isLogo: false,
  },
  {
    src: imagen10.src,
    alt: 'Estructura metálica liviana instalada por Full Solución en Guatemala',
    isLogo: false,
  },
  {
    src: imagen11.src,
    alt: 'Proyecto de soldadura industrial en Guatemala por Full Solución',
    isLogo: false,
  },
  {
    src: logo.src,
    alt: 'Full Solución — Servicios eléctricos y técnicos en Guatemala y Huehuetenango',
    isLogo: true,
  },
];
---

<section
  id="inicio"
  class="hero"
  data-interval="5000"
  aria-label="Full Solución — Servicios eléctricos, energía solar y automatización industrial en Guatemala y Huehuetenango"
>

  <div class="hero__layer hero__layer--blue" aria-hidden="true"></div>

  <div class="hero__layer hero__layer--silver" aria-hidden="true">
    <span class="hero__tri hero__tri--s1"></span>
    <span class="hero__tri hero__tri--s2"></span>
    <span class="hero__tri hero__tri--s3"></span>
    <span class="hero__tri hero__tri--s4"></span>
  </div>

  <div class="hero__layer hero__layer--graphite" aria-hidden="true">
    <span class="hero__tri hero__tri--g1"></span>
    <span class="hero__tri hero__tri--g2"></span>
    <span class="hero__tri hero__tri--g3"></span>
    <span class="hero__tri hero__tri--g4"></span>
    <span class="hero__tri hero__tri--g5"></span>
    <span class="hero__tri hero__tri--g6"></span>
    <span class="hero__tri hero__tri--g7"></span>
  </div>

  <div class="hero__layer hero__layer--v-accent" aria-hidden="true"></div>
  <div class="hero__layer hero__layer--v-line" aria-hidden="true"></div>

  <div class="hero__photo">
    <div class="hero__photo-clip">
      <div class="hero__carousel">
        {heroImages.map((img, i) => (
          <div
            class={`hero__slide ${img.isLogo ? 'hero__slide--logo' : ''}`}
            data-active={i === 0 ? 'true' : 'false'}
          >
            {img.isLogo ? (
              <div class="hero__logo-wrap">
                <img
                  src={img.src}
                  alt={img.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                  width="600"
                  height="600"
                />
                <span class="hero__logo-text">FULL SOLUCIÓN</span>
              </div>
            ) : (
              <img
                src={img.src}
                alt={img.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
                width="1200"
                height="800"
              />
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="hero__content">
    <h1 class="hero__title">
      <span class="hero__title-blue">Servicios eléctricos</span>
      <span class="hero__title-white">y técnicos</span><br />
      <span class="hero__title-white">en Guatemala y Huehuetenango</span>
    </h1>

    <div class="hero__divider" aria-hidden="true">
      <span class="hero__divider-dot"></span>
      <span class="hero__divider-line"></span>
      <span class="hero__divider-dot"></span>
    </div>

    <p class="hero__lead">
      En <strong>Full Solución</strong> (Full Solution) diseñamos, instalamos y mantenemos
      los sistemas eléctricos, de energía solar y de automatización industrial que hacen
      funcionar tu planta y tu hogar en toda Guatemala.
    </p>

    <button
      type="button"
      class="hero__cta"
      data-contact-trigger
      data-service="hero"
      data-service-title="Trabajemos juntos"
      aria-label="Contáctanos por WhatsApp"
    >CONOCE MÁS</button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 7;
    max-height: 90vh;
    min-height: 480px;
    overflow: hidden;
    background: #1E2530;
    isolation: isolate;
  }

  .hero__layer--blue {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, #0A4BD3 0%, #021A5A 100%);
    clip-path: polygon(0 0, 22% 32%, 0 100%);
  }

  .hero__layer--silver {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #CBD5E1;
    clip-path: polygon(0 0, 31% 0, 18% 100%, 0 100%);
    filter: drop-shadow(8px 0 16px rgba(0, 0, 0, 0.35));
    overflow: hidden;
  }

  .hero__tri { position: absolute; pointer-events: none; }

  .hero__tri--s1 { inset: 0; background: rgba(255,255,255,0.35); clip-path: polygon(0 0, 31% 0, 0 55%); }
  .hero__tri--s2 { inset: 0; background: rgba(148,163,184,0.35); clip-path: polygon(0 100%, 18% 100%, 0 55%); }
  .hero__tri--s3 { inset: 0; background: rgba(255,255,255,0.18); clip-path: polygon(0 55%, 31% 0, 18% 100%); }
  .hero__tri--s4 { inset: 0; background: rgba(100,116,139,0.25); clip-path: polygon(0 0, 18% 100%, 0 100%); }

  .hero__layer--graphite {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #1E2530;
    clip-path: polygon(25% 0, 72% 0, 58% 60%, 72% 100%, 12% 100%);
    overflow: hidden;
  }

  .hero__tri--g1 { inset: 0; background: rgba(255,255,255,0.03); clip-path: polygon(25% 0, 58% 60%, 12% 100%); }
  .hero__tri--g2 { inset: 0; background: rgba(255,255,255,0.05); clip-path: polygon(25% 0, 48% 0, 58% 60%); }
  .hero__tri--g3 { inset: 0; background: rgba(0,0,0,0.12);       clip-path: polygon(48% 0, 72% 0, 58% 60%); }
  .hero__tri--g4 { inset: 0; background: rgba(255,255,255,0.04); clip-path: polygon(58% 60%, 72% 0, 72% 100%); }
  .hero__tri--g5 { inset: 0; background: rgba(0,0,0,0.08);       clip-path: polygon(58% 60%, 72% 100%, 42% 100%); }
  .hero__tri--g6 { inset: 0; background: rgba(255,255,255,0.02); clip-path: polygon(12% 100%, 42% 100%, 58% 60%); }
  .hero__tri--g7 { inset: 0; background: rgba(0,0,0,0.06);       clip-path: polygon(12% 100%, 58% 60%, 25% 0%); }

  .hero__layer--v-accent {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: #0A4BD3;
    clip-path: polygon(70% 0, 100% 0, 100% 25%, 75% 65%, 100% 100%, 70% 100%, 56% 60%);
  }

  .hero__layer--v-line {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #FFFFFF;
    clip-path: polygon(71% 0, 73% 0, 60% 60%, 73% 100%, 71% 100%, 57% 60%);
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: 6;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0f1823;
    clip-path: polygon(72% 0, 100% 0, 100% 100%, 72% 100%, 58% 60%);
  }

  .hero__photo-clip {
    position: absolute;
    top: 0;
    right: 0;
    width: 42%;
    height: 100%;
    overflow: hidden;
    background: #0f1823;
  }

  .hero__carousel {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0f1823;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    background: #0f1823;
    opacity: 0;
    visibility: hidden;
    z-index: 0;
    transform: scale(1.04);
    transition:
      opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
      transform 1.2s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0.9s;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    pointer-events: none;
    overflow: hidden;
  }

  .hero__slide[data-active='true'] {
    opacity: 1;
    visibility: visible;
    z-index: 1;
    transform: scale(1);
    pointer-events: auto;
    transition:
      opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1),
      transform 1.2s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0s linear 0s;
  }

  .hero__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    padding: 0;
    box-sizing: border-box;
    background: transparent;
    user-select: none;
    -webkit-user-drag: none;
    filter: saturate(0.9) brightness(0.95) contrast(1.05);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition: none;
  }

  .hero__slide--logo {
    align-items: center;
    justify-content: center;
  }

  .hero__slide--logo .hero__logo-wrap {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 1.4vw, 1.2rem);
    width: 100%;
    height: 100%;
    padding: 6% 8%;
    box-sizing: border-box;
  }

  .hero__slide--logo .hero__logo-wrap img {
    display: block;
    width: auto;
    height: 60%;
    max-width: 45%;
    object-fit: contain;
    object-position: center center;
    padding: 0;
    flex: 0 0 auto;
    filter: saturate(0.9) brightness(0.95) contrast(1.05);
  }

  .hero__logo-text {
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: clamp(0.9rem, 1.4vw, 1.5rem);
    line-height: 1.15;
    color: #ffffff;
    text-align: left;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .hero__content {
    position: absolute;
    top: 50%;
    left: 28%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.9rem;
    width: 34%;
    max-width: 520px;
  }

  .hero__title {
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 800;
    font-size: clamp(1.4rem, 2.4vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .hero__title-blue  { color: #0A4BD3; margin-right: 0.35em; }
  .hero__title-white { color: #ffffff; }

  .hero__divider {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 240px;
  }
  .hero__divider-line { flex: 1; height: 1px; background: rgba(255,255,255,0.55); }
  .hero__divider-dot  { width: 5px; height: 5px; border-radius: 50%; background: #ffffff; }

  .hero__lead {
    font-size: clamp(0.78rem, 0.9vw, 0.92rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    max-width: 42ch;
  }

  .hero__lead strong {
    color: #ffffff;
    font-weight: 700;
  }

  .hero__cta {
    position: relative;
    display: inline-block;
    margin: 0.3rem 0 0;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    width: auto;
    min-width: 130px;
    padding: 0.55rem 1.2rem;
    background-color: var(--fs-accent, #107bcd);
    border: 1px solid var(--fs-accent, #107bcd);
    border-radius: 999px;
    color: #ffffff;
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    text-decoration: none;
    text-align: center;

    box-shadow:
      0 3px 9px -3px rgba(16, 123, 205, 0.5),
      0 9px 20px -10px rgba(16, 123, 205, 0.6);

    transition:
      background-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero__cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.45) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-20deg);
    transition: left 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 1;
  }

  .hero__cta:hover::before { left: 130%; }

  .hero__cta:hover {
    background-color: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.55);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow:
      0 5px 12px -5px rgba(20, 22, 31, 0.25),
      0 14px 30px -14px rgba(20, 33, 86, 0.35);
  }

  .hero__cta:active {
    background-color: rgba(12, 187, 204, 0.35);
    border-color: rgba(12, 187, 204, 0.75);
    color: #ffffff;
    transform: translateY(0) scale(0.98);
  }

  .hero__cta:focus-visible {
    outline: 2px solid var(--fs-highlight, #0cbbcc);
    outline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .hero__content { width: 38%; left: 26%; }
    .hero__title   { font-size: clamp(1.2rem, 2.2vw, 2rem); }
  }

  @media (max-width: 900px) {
    .hero {
      aspect-ratio: auto;
      min-height: 100svh;
      max-height: none;
      display: block;
      background: #000000;
      overflow: hidden;
      position: relative;
    }

    .hero__layer--blue,
    .hero__layer--silver,
    .hero__layer--graphite,
    .hero__layer--v-accent,
    .hero__layer--v-line { display: none; }

    .hero__photo {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      clip-path: none;
      background: #000000;
      z-index: 1;
    }

    .hero__photo-clip {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background: #000000;
    }

    .hero__carousel {
      background: #000000;
      width: 100%;
      height: 100%;
    }

    .hero__slide {
      justify-content: center;
      align-items: center;
      background: #000000;
    }

    .hero__slide img {
      object-fit: cover;
      object-position: center center;
      padding: 0;
      width: 100%;
      height: 100%;
    }

    .hero__slide--logo .hero__logo-wrap {
      flex-direction: row;
      padding: 6% 8%;
      gap: 0.8rem;
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
    }

    .hero__slide--logo .hero__logo-wrap img {
      width: auto;
      height: 55%;
      max-width: 45%;
      padding: 0;
    }

    .hero__logo-text {
      font-size: clamp(0.85rem, 3.5vw, 1.2rem);
    }

    .hero__content {
      position: absolute;
      left: 50%;
      bottom: 8%;
      transform: translateX(-50%);
      top: auto;
      width: min(90%, 520px);
      max-width: 520px;
      padding: 1.5rem 1.4rem 1.7rem;
      align-items: center;
      text-align: center;
      gap: 0.7rem;
      z-index: 10;

      background: rgba(30, 37, 48, 0.55);
      backdrop-filter: blur(10px) saturate(1.1);
      -webkit-backdrop-filter: blur(10px) saturate(1.1);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 16px;
      box-shadow:
        0 12px 32px -12px rgba(0, 0, 0, 0.65),
        inset 0 1px 0 rgba(255, 255, 255, 0.18);
    }

    .hero__divider { max-width: 200px; }
    .hero__lead    { max-width: 50ch; }
  }

  @media (max-width: 560px) {
    .hero__content {
      bottom: 6%;
      padding: 1.3rem 1.1rem 1.5rem;
      border-radius: 14px;
    }
    .hero__title { font-size: clamp(1.3rem, 6vw, 1.7rem); }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');

  if (hero && !hero.dataset.carouselInit) {
    hero.dataset.carouselInit = 'true';

    const slides = hero.querySelectorAll<HTMLElement>('.hero__slide');
    const interval = Number(hero.dataset.interval ?? 5000);

    if (slides.length > 1) {
      let current = 0;
      let rafId: number | null = null;
      let lastTime = performance.now();
      let isPaused = false;

      slides.forEach((s, i) => {
        s.dataset.active = i === 0 ? 'true' : 'false';
      });

      const nextSlide = () => {
        slides[current].dataset.active = 'false';
        current = (current + 1) % slides.length;
        slides[current].dataset.active = 'true';
      };

      const tick = (now: number) => {
        if (!isPaused && now - lastTime >= interval) {
          nextSlide();
          lastTime = now;
        }
        rafId = requestAnimationFrame(tick);
      };

      const start = () => {
        if (rafId !== null) return;
        lastTime = performance.now();
        rafId = requestAnimationFrame(tick);
      };

      const stop = () => {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      };

      document.addEventListener('visibilitychange', () => {
        isPaused = document.hidden;
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      });

      const io = new IntersectionObserver(
        ([entry]) => {
          isPaused = !entry.isIntersecting;
          if (entry.isIntersecting && !document.hidden) {
            start();
          } else {
            stop();
          }
        },
        { threshold: 0.15 }
      );
      io.observe(hero);

      start();

      document.addEventListener('astro:before-swap', () => {
        stop();
        io.disconnect();
      });
    }
  }
</script>