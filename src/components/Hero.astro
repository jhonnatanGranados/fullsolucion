---
// src/components/Hero.astro

import portada  from '../assets/portada.jpg';
import logo     from '../assets/logo.png';
import imagen2  from '../assets/imagen2.webp';
import imagen3  from '../assets/imagen3.webp';
import imagen4  from '../assets/imagen4.webp';
import imagen5  from '../assets/imagen5.webp';
import imagen6  from '../assets/imagen6.webp';
import imagen7  from '../assets/imagen7.webp';
import imagen8  from '../assets/imagen8.webp';
import imagen9  from '../assets/imagen9.webp';
import imagen10 from '../assets/imagen10.webp';
import imagen11 from '../assets/imagen11.webp';

const heroImages = [
  { src: portada.src,  isLogo: false },
  { src: imagen2.src,  isLogo: false },
  { src: imagen3.src,  isLogo: false },
  { src: imagen4.src,  isLogo: false },
  { src: imagen5.src,  isLogo: false },
  { src: imagen6.src,  isLogo: false },
  { src: imagen7.src,  isLogo: false },
  { src: imagen8.src,  isLogo: false },
  { src: imagen9.src,  isLogo: false },
  { src: imagen10.src, isLogo: false },
  { src: imagen11.src, isLogo: false },
  { src: logo.src,     isLogo: true  },
];
---

<!-- ✅ HERO vectorial con clip-path (proporción 3:1) -->
<section
  id="inicio"
  class="hero"
  data-interval="5000"
>

  <!-- ✅ CAPA 1: Triángulo azul fondo izquierdo -->
  <div class="hero__layer hero__layer--blue" aria-hidden="true"></div>

  <!-- ✅ CAPA 2: Franja diagonal gris/plata -->
  <div class="hero__layer hero__layer--silver" aria-hidden="true">
    <span class="hero__tri hero__tri--s1"></span>
    <span class="hero__tri hero__tri--s2"></span>
    <span class="hero__tri hero__tri--s3"></span>
    <span class="hero__tri hero__tri--s4"></span>
  </div>

  <!-- ✅ CAPA 3: Polígono principal -->
  <div class="hero__layer hero__layer--graphite" aria-hidden="true">
    <span class="hero__tri hero__tri--g1"></span>
    <span class="hero__tri hero__tri--g2"></span>
    <span class="hero__tri hero__tri--g3"></span>
    <span class="hero__tri hero__tri--g4"></span>
    <span class="hero__tri hero__tri--g5"></span>
    <span class="hero__tri hero__tri--g6"></span>
    <span class="hero__tri hero__tri--g7"></span>
  </div>

  <!-- ✅ CAPA 4: Marco en V -->
  <div class="hero__layer hero__layer--v-accent" aria-hidden="true"></div>
  <div class="hero__layer hero__layer--v-line" aria-hidden="true"></div>

  <!-- ✅ CAPA 5: Máscara de recorte para la fotografía -->
  <div class="hero__photo" aria-hidden="true">
    <div class="hero__photo-clip">
      <div class="hero__carousel">
        {heroImages.map((img, i) => (
          <div
            class={`hero__slide ${img.isLogo ? 'hero__slide--logo' : ''}`}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <img
              src={img.src}
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ✅ CONTENIDO: texto central -->
  <div class="hero__content">
    <h1 class="hero__title">
      <span class="hero__title-blue">Trabajemos</span>
      <span class="hero__title-white">juntos</span><br />
      <span class="hero__title-white">y construyamos tu proyecto</span>
    </h1>

    <div class="hero__divider" aria-hidden="true">
      <span class="hero__divider-dot"></span>
      <span class="hero__divider-line"></span>
      <span class="hero__divider-dot"></span>
    </div>

    <p class="hero__lead">
      Diseñamos, instalamos y mantenemos los sistemas que hacen funcionar
      tu planta y tu hogar. Soluciones integrales de automatización,
      energía e ingeniería eléctrica.
    </p>

    <!-- ✅ Botón que ABRE el overlay (no navega) -->
    <button
      type="button"
      class="hero__cta"
      data-services-trigger
      aria-expanded="false"
      aria-controls="hero-services-menu"
    >CONOCE MÁS</button>
  </div>

  <!-- ✅ OVERLAY de servicios -->
  <div
    class="hero__services-menu"
    data-services-menu
    id="hero-services-menu"
    hidden
  >
    <div class="hero__services-sheet" role="dialog" aria-modal="true" aria-labelledby="hero-services-title">
      <header class="hero__services-head">
        <h2 id="hero-services-title">Servicios</h2>
        <button
          type="button"
          class="hero__services-close"
          data-services-close
          aria-label="Cerrar"
        >✕</button>
      </header>

      <ul class="hero__services-list">
        <li>
          <button type="button" data-service-target="automatizacion-industrial">
            <span class="hero__services-icon">⚙️</span>
            <span class="hero__services-text">
              <strong>Automatización industrial</strong>
              <small>PLC · HMI · SCADA</small>
            </span>
            <span class="hero__services-arrow">›</span>
          </button>
        </li>
        <li>
          <button type="button" data-service-target="electricidad-general">
            <span class="hero__services-icon">⚡</span>
            <span class="hero__services-text">
              <strong>Ingeniería eléctrica</strong>
              <small>Tableros · Cableado · Tierras</small>
            </span>
            <span class="hero__services-arrow">›</span>
          </button>
        </li>
        <li>
          <button type="button" data-service-target="energias-renovables">
            <span class="hero__services-icon">🔋</span>
            <span class="hero__services-text">
              <strong>Energía y respaldo</strong>
              <small>UPS · Plantas · Solar</small>
            </span>
            <span class="hero__services-arrow">›</span>
          </button>
        </li>
        <li>
          <button type="button" data-service-target="cableado-estructurado">
            <span class="hero__services-icon">🌐</span>
            <span class="hero__services-text">
              <strong>Redes y cableado</strong>
              <small>Voz · Datos · Video</small>
            </span>
            <span class="hero__services-arrow">›</span>
          </button>
        </li>
        <li>
          <button type="button" data-service-target="videovigilancia">
            <span class="hero__services-icon">📹</span>
            <span class="hero__services-text">
              <strong>Videovigilancia</strong>
              <small>Cámaras · Monitoreo</small>
            </span>
            <span class="hero__services-arrow">›</span>
          </button>
        </li>
        <li>
          <button type="button" data-service-target="reparacion-mantenimiento">
            <span class="hero__services-icon">🛠️</span>
            <span class="hero__services-text">
              <strong>Mantenimiento</strong>
              <small>Preventivo · Correctivo</small>
            </span>
            <span class="hero__services-arrow">›</span>
          </button>
        </li>
      </ul>

      <!-- ✅ ÚNICO elemento que SÍ navega a #servicios -->
      <a href="#servicios" class="hero__services-all" data-services-all>
        Ver todos los servicios →
      </a>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     HERO — vectorial con clip-path (proporción 3:1)
     ============================================================ */
  .hero {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 1;
    max-height: 90vh;
    min-height: 380px;
    overflow: hidden;
    background: #1E2530;
    isolation: isolate;
  }

  /* ------------------------------------------------------------
     CAPA 1: Triángulo azul fondo izquierdo
     ------------------------------------------------------------ */
  .hero__layer--blue {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(135deg, #0A4BD3 0%, #021A5A 100%);
    clip-path: polygon(0 0, 22% 32%, 0 100%);
  }

  /* ------------------------------------------------------------
     CAPA 2: Franja diagonal gris/plata
     ------------------------------------------------------------ */
  .hero__layer--silver {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #CBD5E1;
    clip-path: polygon(0 0, 31% 0, 18% 100%, 0 100%);
    filter: drop-shadow(8px 0 16px rgba(0, 0, 0, 0.35));
    overflow: hidden;
  }

  .hero__tri { position: absolute; pointer-events: none; }

  .hero__tri--s1 { inset: 0; background: rgba(255,255,255,0.35); clip-path: polygon(0 0, 31% 0, 0 55%); }
  .hero__tri--s2 { inset: 0; background: rgba(148,163,184,0.35); clip-path: polygon(0 100%, 18% 100%, 0 55%); }
  .hero__tri--s3 { inset: 0; background: rgba(255,255,255,0.18); clip-path: polygon(0 55%, 31% 0, 18% 100%); }
  .hero__tri--s4 { inset: 0; background: rgba(100,116,139,0.25); clip-path: polygon(0 0, 18% 100%, 0 100%); }

  /* ------------------------------------------------------------
     CAPA 3: Polígono principal de fondo
     ------------------------------------------------------------ */
  .hero__layer--graphite {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: #1E2530;
    clip-path: polygon(25% 0, 72% 0, 58% 60%, 72% 100%, 12% 100%);
    overflow: hidden;
  }

  .hero__tri--g1 { inset: 0; background: rgba(255,255,255,0.03); clip-path: polygon(25% 0, 58% 60%, 12% 100%); }
  .hero__tri--g2 { inset: 0; background: rgba(255,255,255,0.05); clip-path: polygon(25% 0, 48% 0, 58% 60%); }
  .hero__tri--g3 { inset: 0; background: rgba(0,0,0,0.12);       clip-path: polygon(48% 0, 72% 0, 58% 60%); }
  .hero__tri--g4 { inset: 0; background: rgba(255,255,255,0.04); clip-path: polygon(58% 60%, 72% 0, 72% 100%); }
  .hero__tri--g5 { inset: 0; background: rgba(0,0,0,0.08);       clip-path: polygon(58% 60%, 72% 100%, 42% 100%); }
  .hero__tri--g6 { inset: 0; background: rgba(255,255,255,0.02); clip-path: polygon(12% 100%, 42% 100%, 58% 60%); }
  .hero__tri--g7 { inset: 0; background: rgba(0,0,0,0.06);       clip-path: polygon(12% 100%, 58% 60%, 25% 0); }

  /* ------------------------------------------------------------
     CAPA 4: Marco en V
     ------------------------------------------------------------ */
  .hero__layer--v-accent {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: #0A4BD3;
    clip-path: polygon(70% 0, 100% 0, 100% 25%, 75% 65%, 100% 100%, 70% 100%, 56% 60%);
  }

  .hero__layer--v-line {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: #FFFFFF;
    clip-path: polygon(71% 0, 73% 0, 60% 60%, 73% 100%, 71% 100%, 57% 60%);
  }

  /* ------------------------------------------------------------
     CAPA 5: Máscara de recorte para la fotografía
     ------------------------------------------------------------ */
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: 6;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0f1823;
    clip-path: polygon(72% 0, 100% 0, 100% 100%, 72% 100%, 58% 60%);
  }

  .hero__photo-clip {
    position: absolute;
    top: 0;
    right: 0;
    width: 42%;
    height: 100%;
    overflow: hidden;
    background: #0f1823;
  }

  .hero__carousel {
    position: relative;
    width: 100%;
    height: 100%;
    background: #0f1823;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    overflow: hidden;
  }
  .hero__slide[data-active='true'] { opacity: 1; }

  .hero__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    padding: 0;
    box-sizing: border-box;
    background: transparent;
    user-select: none;
    -webkit-user-drag: none;
    filter: saturate(0.9) brightness(0.95) contrast(1.05);
  }

  .hero__slide--logo img {
    object-fit: contain;
    object-position: center center;
    padding: 10%;
  }

  /* ------------------------------------------------------------
     CONTENIDO: texto central
     ------------------------------------------------------------ */
  .hero__content {
    position: absolute;
    top: 50%;
    left: 28%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.9rem;
    width: 34%;
    max-width: 520px;
  }

  .hero__title {
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 800;
    font-size: clamp(1.4rem, 2.4vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    color: #ffffff;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
  }
  .hero__title-blue  { color: #0A4BD3; margin-right: 0.35em; }
  .hero__title-white { color: #ffffff; }

  .hero__divider {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 240px;
  }
  .hero__divider-line { flex: 1; height: 1px; background: rgba(255,255,255,0.55); }
  .hero__divider-dot  { width: 5px; height: 5px; border-radius: 50%; background: #ffffff; }

  .hero__lead {
    font-size: clamp(0.78rem, 0.9vw, 0.92rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    max-width: 42ch;
  }

  /* ✅ .hero__cta como <button> estilizado */
  .hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.6rem;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, #0A4BD3, #107bcd);
    color: #ffffff;
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(10, 75, 211, 0.4);
    transition: transform 0.15s ease, filter 0.2s ease;
    margin-top: 0.3rem;
  }
  .hero__cta:hover { transform: translateY(-2px); filter: brightness(1.1); }

  /* ============================================================
     OVERLAY DE SERVICIOS
     ============================================================ */
  .hero__services-menu {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: flex-end;
    justify-content: center;
    background: rgba(11, 15, 26, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    animation: sheetFadeIn 0.25s ease-out;
  }

  .hero__services-menu[hidden] { display: none !important; }

  .hero__services-sheet {
    width: 100%;
    max-height: 85dvh;
    background: #ffffff;
    border-radius: 24px 24px 0 0;
    padding: 1rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    animation: sheetSlideUp 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow:
      0 -10px 40px -10px rgba(0, 0, 0, 0.3),
      0 -1px 0 rgba(255, 255, 255, 0.9) inset;
  }

  .hero__services-sheet::before {
    content: '';
    display: block;
    width: 40px;
    height: 4px;
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.15);
    margin: 0 auto 0.75rem;
  }

  .hero__services-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .hero__services-head h2 {
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 1.25rem;
    font-weight: 800;
    color: #0b0f1a;
    margin: 0;
  }

  .hero__services-close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.06);
    border: none;
    font-size: 1rem;
    font-weight: 700;
    color: #0b0f1a;
    cursor: pointer;
  }

  .hero__services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero__services-list button {
    width: 100%;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: linear-gradient(145deg, #ffffff, #f5f6f8);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 14px;
    cursor: pointer;
    text-align: left;
    transition: transform 0.15s ease, background 0.2s ease;
  }

  .hero__services-list button:active {
    transform: scale(0.98);
    background: linear-gradient(145deg, #f0f2f6, #e6e8ec);
  }

  .hero__services-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(12, 187, 204, 0.15), rgba(16, 123, 205, 0.1));
    border: 1px solid rgba(12, 187, 204, 0.25);
    font-size: 1.25rem;
  }

  .hero__services-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .hero__services-text strong {
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 0.98rem;
    font-weight: 700;
    color: #0b0f1a;
    line-height: 1.2;
  }

  .hero__services-text small {
    font-size: 0.78rem;
    color: #5a6273;
    line-height: 1.3;
  }

  .hero__services-arrow {
    font-size: 1.5rem;
    color: #9aa2b1;
    line-height: 1;
  }

  .hero__services-all {
    display: block;
    margin-top: 1rem;
    padding: 0.9rem 1rem;
    text-align: center;
    font-family: var(--font-display, system-ui, sans-serif);
    font-weight: 700;
    font-size: 0.98rem;
    color: #ffffff;
    background: linear-gradient(135deg, #107bcd, #0A4BD3);
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.2s ease;
  }

  .hero__services-all:hover  { filter: brightness(1.08); }
  .hero__services-all:active { transform: scale(0.98); }

  @keyframes sheetFadeIn  { from { opacity: 0; } to { opacity: 1; } }
  @keyframes sheetSlideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  @media (min-width: 901px) {
    .hero__services-menu { align-items: center; }
    .hero__services-sheet {
      max-width: 480px;
      max-height: 80vh;
      border-radius: 24px;
    }
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 1100px) {
    .hero__content { width: 38%; left: 26%; }
    .hero__title   { font-size: clamp(1.2rem, 2.2vw, 2rem); }
  }

  @media (max-width: 900px) {
    .hero {
      aspect-ratio: auto;
      min-height: 100svh;
      max-height: none;
    }

    .hero__layer--blue,
    .hero__layer--silver,
    .hero__layer--graphite,
    .hero__layer--v-accent,
    .hero__layer--v-line { display: none; }

    .hero { background: linear-gradient(135deg, #1E2530 0%, #0f1823 100%); }

    .hero__photo {
      clip-path: none;
      inset: 0 0 auto 0;
      height: 42vh;
      border-radius: 0 0 24px 24px;
    }

    .hero__photo-clip { width: 100%; height: 100%; }
    .hero__slide      { justify-content: center; }

    .hero__slide img {
      object-fit: contain;
      object-position: center center;
      padding: 2%;
    }

    .hero__slide--logo img { object-fit: contain; padding: 8% 16%; }

    .hero__content {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      width: 100%;
      max-width: 100%;
      padding: 2rem 1.5rem 2.5rem;
      align-items: center;
      text-align: center;
    }

    .hero__divider { max-width: 200px; }
    .hero__lead    { max-width: 50ch; }
  }

  @media (max-width: 560px) {
    .hero__photo { height: 36vh; }
    .hero__title { font-size: clamp(1.3rem, 6vw, 1.7rem); }
  }
</style>

<script>
  // ============================================================
  // Carrusel del Hero
  // ============================================================
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) {
    const slides = hero.querySelectorAll<HTMLElement>('.hero__slide');
    const interval = Number(hero.dataset.interval ?? 5000);

    if (slides.length > 1) {
      let current = 0;
      slides.forEach((s, i) => { s.dataset.active = i === 0 ? 'true' : 'false'; });

      setInterval(() => {
        slides[current].dataset.active = 'false';
        current = (current + 1) % slides.length;
        slides[current].dataset.active = 'true';
      }, interval);
    }
  }

  // ============================================================
  // Overlay de servicios
  // ============================================================
  const servicesTrigger = document.querySelector<HTMLButtonElement>('[data-services-trigger]');
  const servicesMenu    = document.querySelector<HTMLElement>('[data-services-menu]');
  const servicesClose   = document.querySelector<HTMLButtonElement>('[data-services-close]');
  const servicesAll     = document.querySelector<HTMLAnchorElement>('[data-services-all]');

  const openServicesMenu = () => {
    if (!servicesMenu) return;
    servicesMenu.hidden = false;
    document.body.style.overflow = 'hidden';
    servicesTrigger?.setAttribute('aria-expanded', 'true');
  };

  const closeServicesMenu = () => {
    if (!servicesMenu) return;
    servicesMenu.hidden = true;
    document.body.style.overflow = '';
    servicesTrigger?.setAttribute('aria-expanded', 'false');
  };

  servicesTrigger?.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    openServicesMenu();
  });

  servicesClose?.addEventListener('click', closeServicesMenu);

  servicesMenu?.addEventListener('click', (e) => {
    if (e.target === servicesMenu) closeServicesMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && servicesMenu && !servicesMenu.hidden) {
      closeServicesMenu();
    }
  });

  // ✅ "Ver todos los servicios" → cierra overlay y deja que el <a href="#servicios"> navegue
  servicesAll?.addEventListener('click', () => {
    closeServicesMenu();
    // NO hacemos preventDefault: el navegador salta a #servicios
  });

  // ✅ Ítems del overlay → cierran overlay + scroll a la card (NO navegan a otra vista)
  document.querySelectorAll<HTMLButtonElement>('[data-service-target]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();          // ← evita cualquier navegación por defecto
      e.stopPropagation();

      const target = btn.getAttribute('data-service-target');
      if (!target) return;

      closeServicesMenu();

      // Busca la card por slug (id o data-service) en la misma página
      const card =
        document.querySelector<HTMLElement>(`[data-service="${target}"]`) ??
        document.getElementById(target) ??
        document.querySelector<HTMLElement>(`#${CSS.escape(target)}`);

      if (card) {
        setTimeout(() => {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });

          if (
            card.classList.contains('card--expandable') &&
            !card.classList.contains('card--open')
          ) {
            card.querySelector<HTMLButtonElement>('.card__toggle')?.click();
          }
        }, 180);
      }
    });
  });
</script>