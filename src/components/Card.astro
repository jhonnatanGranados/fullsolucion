---
// src/components/Card.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle?: string;
  description: string;
  icon?:
    | 'automation' | 'service' | 'electrical' | 'domotics'
    | 'renewable' | 'consulting' | 'network' | 'camera'
    | 'sound' | 'generator' | 'prefab' | 'paint'
    | 'structure' | 'welding' | 'gas' | 'pvc'
    | 'cleaning' | 'software';
  refCode?: string;
  reverse?: boolean;
  items?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  subtitle = '',
  description,
  icon = 'automation',
  refCode = '',
  reverse = false,
  items = [],
  image,
  imageAlt = title,
} = Astro.props;

const icons: Record<string, string> = {
  automation:
    '<path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.6 15a1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.6a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/>',
  service:
    '<path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>',
  electrical: '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/>',
  domotics:
    '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/>',
  renewable:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  consulting:
    '<rect x="8" y="2" width="8" height="4" rx="0.5"/><path d="M9 4H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-3"/><path d="M9 12h6M9 16h4"/>',
  network:
    '<circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v6M12 13l-5.5 4M12 13l5.5 4"/>',
  camera:
    '<rect x="2" y="7" width="14" height="11" rx="2"/><path d="M16 10.5l5-2.5v9l-5-2.5"/><circle cx="9" cy="12.5" r="2.5"/>',
  sound:
    '<path d="M4 10v4h4l5 4V6l-5 4H4z"/><path d="M17.5 8.5a5 5 0 010 7"/><path d="M20.5 6a9 9 0 010 12"/>',
  generator:
    '<rect x="2" y="7" width="14" height="10" rx="1"/><circle cx="9" cy="12" r="2.5"/><path d="M16 10h3l3 3v4h-6"/><path d="M6 17v2M12 17v2"/>',
  prefab:
    '<path d="M3 21V9l9-6 9 6v12"/><path d="M9 21V13h6v8"/><path d="M3 9h18"/>',
  paint:
    '<path d="M9 3h8v5a2 2 0 01-2 2h-1v3h-3V10H10a2 2 0 01-2-2V3z"/><path d="M11 13v6a2 2 0 002 2 2 2 0 002-2v-6"/>',
  structure:
    '<path d="M4 21V8l8-5 8 5v13"/><path d="M4 21h16"/><path d="M9 21v-6h6v6"/><path d="M4 12h16M4 8h16"/>',
  welding:
    '<path d="M3 20l6-6"/><path d="M13 4l7 7-3 3-7-7z"/><path d="M2 22l3-1 1-3"/><path d="M17 5l2-2M19 8l2-2"/>',
  gas:
    '<path d="M12 2c2 3-2 4-2 7a2 2 0 004 0c0-1-.5-1.5-.5-1.5S16 9 16 13a4 4 0 01-8 0c0-5 4-6 4-11z"/>',
  pvc:
    '<rect x="3" y="3" width="18" height="18" rx="1"/><path d="M12 3v18M3 12h18"/>',
  cleaning:
    '<path d="M14 4l6 6-8.5 8.5a3 3 0 01-4.24 0 3 3 0 010-4.24L16 5.16"/><path d="M4 20l3-3"/>',
  software:
    '<path d="M8 9l-4 4 4 4"/><path d="M16 9l4 4-4 4"/><path d="M13 5l-2 15"/>',
};

const iconPath = icons[icon] ?? icons.automation;
---

<article
  class={`card ${reverse ? 'card--reverse' : ''} ${items.length ? 'card--expandable' : ''} ${image ? 'card--has-image' : ''}`}
  data-tilt
>
  {image && (
    <span class="card__bg" aria-hidden="true">
      <Image
        src={image}
        alt=""
        widths={[600, 900, 1200]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 60vw, 600px"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
        class="card__bg-img"
      />
    </span>
  )}

  <span class="card__glare" aria-hidden="true"></span>

  <div class="card__mark">
    {!image && (
      <span class="card__icon-wrap">
        <svg
          class="card__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={iconPath}
        />
      </span>
    )}
    {refCode && <span class="card__ref">{refCode}</span>}
  </div>

  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    {subtitle && <p class="card__subtitle">{subtitle}</p>}
    <p class="card__desc">{description}</p>

    {items.length > 0 && (
      <div class="card__items">
        <span class="card__items-label">Incluye</span>
        <ul class="card__list">
          {items.map((it) => (
            <li>{it}</li>
          ))}
        </ul>
      </div>
    )}

    <button
      type="button"
      class="card__btn"
      data-contact-trigger
      aria-label={`Contáctanos por ${title}`}
    >
      Contáctanos
    </button>
  </div>
</article>


<style>
  /* ============================================================
     TARJETA — HERO CARD con imagen de fondo
     ============================================================ */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1.35rem;
    padding: 1.9rem 1.9rem;
    border-radius: 22px;
    width: 100%;

    background-color: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);

    box-shadow:
      0 1px 2px rgba(20, 22, 31, 0.04),
      0 12px 28px -18px rgba(20, 33, 86, 0.28),
      0 24px 60px -30px rgba(12, 187, 204, 0.35);

    border: 1px solid rgba(255, 255, 255, 0.35);

    transform-style: preserve-3d;
    transform: perspective(1000px) rotateX(0) rotateY(0) translateZ(0);

    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.35s ease,
      border-color 0.35s ease;
    overflow: hidden;
    isolation: isolate;
  }

  .card.is-tilting {
    transition:
      transform 0.08s linear,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
    will-change: transform;
  }

  /* ============================================================
     IMAGEN DE FONDO
     ============================================================ */
  .card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .card__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      145deg,
      rgba(20, 33, 86, 0.82) 0%,
      rgba(20, 33, 86, 0.68) 45%,
      rgba(12, 187, 204, 0.35) 100%
    );
    pointer-events: none;
  }

  /* ============================================================
     PSEUDO-ELEMENTOS DECORATIVOS
     ============================================================ */
  .card::before,
  .card::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0px 0px 22px rgba(0, 0, 0, 0.08);
    pointer-events: none;
    z-index: 1;
  }

  .card::before {
    height: 80px;
    width: 80px;
    top: -10px;
    left: -40px;
  }

  .card::after {
    height: 40px;
    width: 40px;
    bottom: 20px;
    right: -10px;
    z-index: 2;
  }

  .card--reverse::before {
    left: auto;
    right: -40px;
  }

  .card--reverse::after {
    right: auto;
    left: -10px;
  }

  /* ============================================================
     HOVER / FOCUS
     ============================================================ */
  .card:hover,
  .card:focus-within,
  .card.is-tilting {
    background-color: rgba(255, 255, 255, 0.34);
    border-color: rgba(12, 187, 204, 0.5);
    box-shadow:
      0 2px 6px rgba(20, 22, 31, 0.05),
      0 30px 50px -25px rgba(20, 33, 86, 0.45),
      0 55px 90px -45px rgba(12, 187, 204, 0.55);
  }

  .card--has-image:hover,
  .card--has-image:focus-within,
  .card--has-image.is-tilting {
    background-color: transparent;
  }

  .card--reverse:hover,
  .card--reverse:focus-within,
  .card--reverse.is-tilting {
    border-color: rgba(16, 123, 205, 0.5);
    box-shadow:
      0 2px 6px rgba(20, 22, 31, 0.05),
      0 30px 50px -25px rgba(20, 33, 86, 0.45),
      0 55px 90px -45px rgba(16, 123, 205, 0.55);
  }

  .card--has-image:hover .card__bg-img,
  .card--has-image.is-tilting .card__bg-img {
    transform: scale(1.08);
  }

  /* ============================================================
     BRILLO 3D DINÁMICO
     ============================================================ */
  .card__glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    background: radial-gradient(
      circle at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.5) 0%,
      rgba(12, 187, 204, 0.2) 25%,
      rgba(12, 187, 204, 0) 55%
    );
    transition: opacity 0.35s ease;
    mix-blend-mode: soft-light;
  }

  .card:hover .card__glare,
  .card.is-tilting .card__glare {
    opacity: 1;
  }

  /* ============================================================
     VARIANTE ESPEJO
     ============================================================ */
  .card--reverse {
    grid-template-columns: 1fr 4.5rem;
  }

  .card--reverse .card__mark {
    order: 2;
    align-items: flex-end;
  }

  .card--reverse .card__body {
    order: 1;
    text-align: right;
  }

  .card--reverse .card__desc {
    margin-left: auto;
  }

  /* ============================================================
     ÍCONO / MARCA
     ============================================================ */
  .card__mark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    position: relative;
    z-index: 3;
    transform: translateZ(35px);
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(12, 187, 204, 0.12), rgba(16, 123, 205, 0.08));
    border: 1px solid rgba(12, 187, 204, 0.22);
    color: var(--fs-primary);
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card--reverse .card__icon-wrap {
    background: linear-gradient(135deg, rgba(16, 123, 205, 0.14), rgba(20, 33, 86, 0.08));
    border-color: rgba(16, 123, 205, 0.25);
  }

  .card__icon {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 0.3s ease;
  }

  .card:hover .card__icon-wrap {
    transform: translateZ(50px) translateY(-3px) rotate(-3deg);
  }

  .card:hover .card__icon {
    transform: scale(1.08);
  }

  .card__ref {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--fs-steel);
  }

  .card--has-image .card__ref {
    color: rgba(255, 255, 255, 0.85);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  /* ============================================================
     TEXTO
     ============================================================ */
  .card__body {
    position: relative;
    z-index: 3;
    transform: translateZ(20px);
    transform-style: preserve-3d;
  }

  .card__title {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--fs-primary);
    margin: 0 0 0.35rem;
    letter-spacing: -0.01em;
    line-height: 1.25;
    transform: translateZ(10px);
    transition: transform 0.4s ease;
  }

  .card__subtitle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--fs-accent);
    margin: 0 0 0.55rem;
  }

  .card--reverse .card__subtitle {
    color: var(--fs-highlight);
  }

  .card__desc {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--fs-slate);
    margin: 0;
    max-width: 42ch;
  }

  .card--has-image .card__title {
    color: var(--fs-white);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .card--has-image .card__subtitle {
    color: var(--fs-highlight);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .card--has-image.card--reverse .card__subtitle {
    color: var(--fs-highlight);
  }

  .card--has-image .card__desc {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }

  /* ============================================================
     SUB-SERVICIOS DESPLEGABLES
     ============================================================ */
  .card__items {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    margin-top: 0;
    transition:
      max-height 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      margin-top 0.35s ease;
  }

  .card:hover .card__items,
  .card:focus-within .card__items,
  .card--open .card__items {
    max-height: 600px;
    opacity: 1;
    margin-top: 1rem;
  }

  .card__items-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fs-accent);
    margin-bottom: 0.65rem;
  }

  .card--reverse .card__items-label {
    color: var(--fs-highlight);
  }

  .card--has-image .card__items-label {
    color: var(--fs-highlight);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .card__list li {
    position: relative;
    padding-left: 1rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--fs-slate);
  }

  .card--has-image .card__list li {
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  .card__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--fs-highlight);
  }

  .card--reverse .card__list li::before {
    background: var(--fs-accent);
  }

  .card--has-image .card__list li::before,
  .card--has-image.card--reverse .card__list li::before {
    background: var(--fs-highlight);
    box-shadow: 0 0 0 2px rgba(12, 187, 204, 0.25);
  }

  .card--reverse .card__items {
    text-align: right;
  }

  .card--reverse .card__list li {
    padding-left: 0;
    padding-right: 1rem;
  }

  .card--reverse .card__list li::before {
    left: auto;
    right: 0;
  }

  /* ============================================================
     BOTÓN "CONTÁCTANOS"
     ============================================================ */
  .card__btn {
    position: relative;
    display: inline-block;
    margin: 1.2rem auto 0;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    width: auto;
    min-width: 160px;
    max-width: none;
    padding: 0.75rem 1.6rem;
    background-color: var(--fs-accent);
    border: 1px solid var(--fs-accent);
    border-radius: 999px;
    color: var(--fs-white);
    cursor: pointer;
    overflow: hidden;
    isolation: isolate;
    transform: translateZ(30px);
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);

    box-shadow:
      0 4px 12px -4px rgba(16, 123, 205, 0.5),
      0 12px 28px -12px rgba(16, 123, 205, 0.6);

    transition:
      background-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      backdrop-filter 0.35s ease,
      -webkit-backdrop-filter 0.35s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card__btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.45) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-20deg);
    transition: left 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
    z-index: 1;
  }

  .card__btn:hover::before {
    left: 130%;
  }

  .card__btn:hover {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.45);
    color: var(--fs-primary);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    transform: translateZ(40px) translateY(-2px);
    box-shadow:
      0 6px 16px -6px rgba(20, 22, 31, 0.25),
      0 18px 40px -16px rgba(20, 33, 86, 0.35),
      0 0 0 1px rgba(255, 255, 255, 0.15) inset;
  }

  .card__btn:active {
    background-color: rgba(12, 187, 204, 0.28);
    border-color: rgba(12, 187, 204, 0.65);
    color: var(--fs-primary);
    backdrop-filter: blur(12px) saturate(160%);
    -webkit-backdrop-filter: blur(12px) saturate(160%);
    transform: translateZ(20px) translateY(0) scale(0.98);
    box-shadow:
      0 3px 10px -4px rgba(12, 187, 204, 0.5),
      0 10px 22px -12px rgba(12, 187, 204, 0.55),
      0 0 0 2px rgba(12, 187, 204, 0.25) inset;
  }

  /* Fix: contraste del botón sobre card con imagen de fondo oscura */
  .card--has-image .card__btn:hover {
    color: var(--fs-white);
    background-color: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.55);
  }

  .card--has-image .card__btn:active {
    color: var(--fs-white);
    background-color: rgba(12, 187, 204, 0.35);
    border-color: rgba(12, 187, 204, 0.75);
  }

  .card__btn:focus-visible {
    outline: 2px solid var(--fs-highlight);
    outline-offset: 3px;
    animation: btnGlow 1.8s ease-in-out infinite;
  }

  /* ============================================================
     ANIMACIONES
     ============================================================ */
  @keyframes cardBreathe {
    0%,
    100% {
      box-shadow:
        0 2px 6px rgba(20, 22, 31, 0.05),
        0 30px 50px -25px rgba(20, 33, 86, 0.45),
        0 55px 90px -45px rgba(12, 187, 204, 0.55);
    }
    50% {
      box-shadow:
        0 2px 6px rgba(20, 22, 31, 0.05),
        0 34px 56px -26px rgba(20, 33, 86, 0.5),
        0 65px 100px -48px rgba(12, 187, 204, 0.7);
    }
  }

  .card.is-tilting {
    animation: cardBreathe 3.2s ease-in-out infinite;
  }

  @keyframes btnGlow {
    0%,
    100% {
      box-shadow:
        0 4px 12px -4px rgba(16, 123, 205, 0.5),
        0 12px 28px -12px rgba(16, 123, 205, 0.6);
    }
    50% {
      box-shadow:
        0 5px 16px -5px rgba(16, 123, 205, 0.6),
        0 16px 34px -14px rgba(16, 123, 205, 0.75);
    }
  }

