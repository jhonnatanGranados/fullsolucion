---
// src/components/Card.astro  (VERSIÓN 6 — altura uniforme + imagen muy atenuada en estado cerrado)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  subtitle?: string;
  description: string;
  icon?:
    | 'automation' | 'service' | 'electrical' | 'domotics'
    | 'renewable' | 'consulting' | 'network' | 'camera'
    | 'sound' | 'generator' | 'prefab' | 'paint'
    | 'structure' | 'welding' | 'gas' | 'pvc'
    | 'cleaning' | 'software';
  refCode?: string;
  reverse?: boolean;
  items?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  subtitle = '',
  description,
  icon = 'automation',
  refCode = '',
  reverse = false,
  items = [],
  image,
  imageAlt = title,
} = Astro.props;

const icons: Record<string, string> = {
  automation:
    '<path d="M12 15a3 3 0 100-6 3 3 0 000 6z"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 004.6 15a1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 4.6a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z"/>',
  service:
    '<path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>',
  electrical: '<path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/>',
  domotics:
    '<path d="M3 11l9-8 9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/>',
  renewable:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  consulting:
    '<rect x="8" y="2" width="8" height="4" rx="0.5"/><path d="M9 4H6a2 2 0 00-2 2v14a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-3"/><path d="M9 12h6M9 16h4"/>',
  network:
    '<circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v6M12 13l-5.5 4M12 13l5.5 4"/>',
  camera:
    '<rect x="2" y="7" width="14" height="11" rx="2"/><path d="M16 10.5l5-2.5v9l-5-2.5"/><circle cx="9" cy="12.5" r="2.5"/>',
  sound:
    '<path d="M4 10v4h4l5 4V6l-5 4H4z"/><path d="M17.5 8.5a5 5 0 010 7"/><path d="M20.5 6a9 9 0 010 12"/>',
  generator:
    '<rect x="2" y="7" width="14" height="10" rx="1"/><circle cx="9" cy="12" r="2.5"/><path d="M16 10h3l3 3v4h-6"/><path d="M6 17v2M12 17v2"/>',
  prefab:
    '<path d="M3 21V9l9-6 9 6v12"/><path d="M9 21V13h6v8"/><path d="M3 9h18"/>',
  paint:
    '<path d="M9 3h8v5a2 2 0 01-2 2h-1v3h-3V10H10a2 2 0 01-2-2V3z"/><path d="M11 13v6a2 2 0 002 2 2 2 0 002-2v-6"/>',
  structure:
    '<path d="M4 21V8l8-5 8 5v13"/><path d="M4 21h16"/><path d="M9 21v-6h6v6"/><path d="M4 12h16M4 8h16"/>',
  welding:
    '<path d="M3 20l6-6"/><path d="M13 4l7 7-3 3-7-7z"/><path d="M2 22l3-1 1-3"/><path d="M17 5l2-2M19 8l2-2"/>',
  gas:
    '<path d="M12 2c2 3-2 4-2 7a2 2 0 004 0c0-1-.5-1.5-.5-1.5S16 9 16 13a4 4 0 01-8 0c0-5 4-6 4-11z"/>',
  pvc:
    '<rect x="3" y="3" width="18" height="18" rx="1"/><path d="M12 3v18M3 12h18"/>',
  cleaning:
    '<path d="M14 4l6 6-8.5 8.5a3 3 0 01-4.24 0 3 3 0 010-4.24L16 5.16"/><path d="M4 20l3-3"/>',
  software:
    '<path d="M8 9l-4 4 4 4"/><path d="M16 9l4 4-4 4"/><path d="M13 5l-2 15"/>',
};

const iconPath = icons[icon] ?? icons.automation;
---

<article
  class={`card ${reverse ? 'card--reverse' : ''} ${items.length ? 'card--expandable' : ''} ${image ? 'card--has-image' : ''}`}
  data-tilt
>
  {image && (
    <span class="card__bg" aria-hidden="true">
      <Image
        src={image}
        alt=""
        widths={[600, 900, 1200]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 60vw, 600px"
        format="webp"
        quality={75}
        loading="lazy"
        decoding="async"
        class="card__bg-img"
      />
    </span>
  )}

  <!-- Velo azul marino: visible solo cuando está cerrada -->
  <span class="card__veil" aria-hidden="true"></span>

  <span class="card__glare" aria-hidden="true"></span>

  <div class="card__mark">
    {!image && (
      <span class="card__icon-wrap">
        <svg
          class="card__icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={iconPath}
        />
      </span>
    )}
  </div>

  <div class="card__body">
    <!-- Cabecera: título + subtítulo + botón toggle -->
    <div class="card__header">
      <div class="card__header-text">
        <h3 class="card__title">{title}</h3>
        {/* ✅ Reservamos siempre el espacio del subtítulo para mantener altura uniforme */}
        {subtitle ? (
          <p class="card__subtitle">{subtitle}</p>
        ) : (
          <p class="card__subtitle card__subtitle--empty" aria-hidden="true">&nbsp;</p>
        )}
      </div>
      <button
        type="button"
        class="card__toggle"
        aria-expanded="false"
        aria-label={`Expandir ${title}`}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>

    <!-- Contenido colapsable -->
    <div class="card__content">
      <p class="card__desc">{description}</p>

      {items.length > 0 && (
        <div class="card__items">
          <span class="card__items-label">Incluye</span>
          <ul class="card__list">
            {items.map((it) => (
              <li>{it}</li>
            ))}
          </ul>
        </div>
      )}

      <button
        type="button"
        class="card__btn"
        data-contact-trigger
        data-service={refCode}
        data-service-title={title}
        aria-label={`Contáctanos por ${title}`}
      >
        Contáctanos
      </button>
    </div>
  </div>
</article>

<script>
  // Acordeón exclusivo: solo una tarjeta abierta a la vez
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.card--expandable');

    cards.forEach((card) => {
      const toggle = card.querySelector('.card__toggle');
      if (!toggle) return;

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = card.classList.contains('card--open');

        // Cerrar todas
        cards.forEach((c) => {
          c.classList.remove('card--open');
          const t = c.querySelector('.card__toggle');
          if (t) t.setAttribute('aria-expanded', 'false');
        });

        // Si estaba cerrada, abrirla
        if (!isOpen) {
          card.classList.add('card--open');
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>

<style>
  /* ============================================================
     TARJETA — altura uniforme garantizada en estado cerrado
     ============================================================ */
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 0.85rem;
    padding: 0.95rem 1.25rem;
    border-radius: 18px;
    width: 100%;
    box-sizing: border-box;

    /* ✅ ALTURA EXACTA EN ESTADO CERRADO (todas iguales) */
    height: var(--card-collapsed-h, 104px);
    min-height: var(--card-collapsed-h, 104px);

    /* ✅ NO se estira a la altura de la fila del grid */
    align-self: start;

    align-items: center;

    /* ✅ DARK: fondo azul marino */
    background-color: rgba(20, 33, 86, 0.88);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);

    box-shadow:
      0 1px 2px rgba(20, 22, 31, 0.08),
      0 10px 24px -14px rgba(20, 33, 86, 0.55),
      0 20px 50px -28px rgba(12, 187, 204, 0.35);

    border: 1px solid rgba(255, 255, 255, 0.14);

    transform-style: preserve-3d;
    transform: perspective(1000px) rotateX(0) rotateY(0) translateZ(0);

    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.35s ease,
      border-color 0.35s ease,
      height 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    isolation: isolate;
  }

  /* ✅ Al abrir: altura automática, crece según contenido */
  .card--open {
    align-items: stretch;
    height: auto;
    min-height: 0;
    align-self: start;
  }

  .card.is-tilting {
    transition:
      transform 0.08s linear,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
    will-change: transform;
  }

  /* ============================================================
     IMAGEN DE FONDO
     ============================================================ */
  .card__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ✅ CERRADA: imagen MUY atenuada, apenas un susurro decorativo */
  .card__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);

    filter: saturate(0.25) brightness(0.35) contrast(0.85);
    opacity: 0.12;

    transition:
      filter 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ✅ ABIERTA: imagen a plena intensidad */
  .card--open .card__bg-img {
    filter: grayscale(0) saturate(1) brightness(1) contrast(1);
    opacity: 1;
  }

  .card__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      145deg,
      rgba(20, 33, 86, 0) 0%,
      rgba(20, 33, 86, 0) 100%
    );
    transition: background 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .card--open .card__bg::after {
    background: linear-gradient(
      145deg,
      rgba(20, 33, 86, 0.42) 0%,
      rgba(20, 33, 86, 0.25) 45%,
      rgba(12, 187, 204, 0.15) 100%
    );
  }

  /* ============================================================
     VELO AZUL MARINO
     ============================================================ */
  /* ✅ CERRADA: velo casi opaco + blur para atenuar aún más la imagen */
  .card__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      rgba(20, 33, 86, 0.97) 0%,
      rgba(20, 33, 86, 0.92) 55%,
      rgba(14, 60, 120, 0.82) 100%
    );
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    opacity: 1;
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card--open .card__veil {
    opacity: 0;
  }

  /* ============================================================
     PSEUDO-ELEMENTOS DECORATIVOS
     ============================================================ */
  .card::before,
  .card::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: 0px 0px 22px rgba(0, 0, 0, 0.12);
    pointer-events: none;
    z-index: 1;
  }

  .card::before {
    height: 60px;
    width: 60px;
    top: -8px;
    left: -30px;
  }

  .card::after {
    height: 30px;
    width: 30px;
    bottom: 14px;
    right: -6px;
    z-index: 2;
  }

  .card--reverse::before {
    left: auto;
    right: -30px;
  }

  .card--reverse::after {
    right: auto;
    left: -6px;
  }

  /* ============================================================
     HOVER / FOCUS
     ============================================================ */
  .card:hover,
  .card:focus-within,
  .card.is-tilting {
    background-color: rgba(20, 33, 86, 0.94);
    border-color: rgba(12, 187, 204, 0.55);
    box-shadow:
      0 2px 6px rgba(20, 22, 31, 0.1),
      0 26px 44px -22px rgba(20, 33, 86, 0.6),
      0 48px 80px -40px rgba(12, 187, 204, 0.5);
  }

  .card--has-image:hover,
  .card--has-image:focus-within,
  .card--has-image.is-tilting {
    background-color: transparent;
  }

  .card--reverse:hover,
  .card--reverse:focus-within,
  .card--reverse.is-tilting {
    border-color: rgba(16, 123, 205, 0.6);
    box-shadow:
      0 2px 6px rgba(20, 22, 31, 0.1),
      0 26px 44px -22px rgba(20, 33, 86, 0.6),
      0 48px 80px -40px rgba(16, 123, 205, 0.5);
  }

  .card--has-image.card--open:hover .card__bg-img,
  .card--has-image.card--open.is-tilting .card__bg-img {
    transform: scale(1.06);
  }

  /* ============================================================
     BRILLO 3D DINÁMICO
     ============================================================ */
  .card__glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 5;
    opacity: 0;
    background: radial-gradient(
      circle at var(--glare-x, 50%) var(--glare-y, 50%),
      rgba(255, 255, 255, 0.5) 0%,
      rgba(12, 187, 204, 0.2) 25%,
      rgba(12, 187, 204, 0) 55%
    );
    transition: opacity 0.35s ease;
    mix-blend-mode: soft-light;
  }

  .card:hover .card__glare,
  .card.is-tilting .card__glare {
    opacity: 1;
  }

  /* ============================================================
     VARIANTE ESPEJO
     ============================================================ */
  .card--reverse {
    grid-template-columns: 2.6rem 1fr;
  }

  .card--reverse .card__mark {
    order: 1;
    align-items: flex-start;
  }

  .card--reverse .card__body {
    order: 2;
    text-align: center;
  }

  .card--reverse.card--open .card__body {
    text-align: left;
  }

  /* ============================================================
     ÍCONO / MARCA
     ============================================================ */
  .card__mark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    position: relative;
    z-index: 3;
    transform: translateZ(35px);
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 11px;
    background: linear-gradient(135deg, rgba(12, 187, 204, 0.22), rgba(16, 123, 205, 0.14));
    border: 1px solid rgba(12, 187, 204, 0.4);
    color: var(--fs-highlight);
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card--reverse .card__icon-wrap {
    background: linear-gradient(135deg, rgba(16, 123, 205, 0.26), rgba(20, 33, 86, 0.14));
    border-color: rgba(16, 123, 205, 0.45);
  }

  .card__icon {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.3s ease;
  }

  .card:hover .card__icon-wrap {
    transform: translateZ(50px) translateY(-3px) rotate(-3deg);
  }

  .card:hover .card__icon {
    transform: scale(1.08);
  }

  /* ============================================================
     TEXTO — CERRADO CENTRADO, ABIERTO A LA IZQUIERDA
     ============================================================ */
  .card__body {
    position: relative;
    z-index: 3;
    transform: translateZ(20px);
    transform-style: preserve-3d;
    display: flex;
    flex-direction: column;
    text-align: center;
    transition: text-align 0.3s ease;
  }

  .card--open .card__body {
    text-align: left;
  }

  .card__header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: justify-content 0.3s ease;
  }

  .card--open .card__header {
    justify-content: space-between;
  }

  .card__header-text {
    flex: 1;
    min-width: 0;
    text-align: center;
    transition: text-align 0.3s ease;
  }

  .card--open .card__header-text {
    text-align: left;
  }

  /* ✅ Título limitado a 2 líneas para no romper la altura uniforme */
  .card__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--fs-white);
    margin: 0 0 0.2rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
    transform: translateZ(10px);
    text-align: center;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;

    transition:
      color 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      font-size 0.4s ease,
      text-align 0.3s ease;
  }

  .card--open .card__title {
    color: var(--fs-white);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);
    font-size: 1.65rem;
    text-align: left;
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  /* Subtítulo */
  .card__subtitle {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--fs-highlight);
    opacity: 1;
    margin: 0;
    text-align: center;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);

    min-height: 1em;
    line-height: 1.2;

    transition:
      color 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      text-align 0.3s ease;
  }

  .card__subtitle--empty {
    visibility: hidden;
    pointer-events: none;
  }

  .card--open .card__subtitle {
    color: var(--fs-highlight);
    opacity: 1;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.55);
    text-align: left;
  }

  /* Botón toggle (chevron) */
  .card__toggle {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.95rem;
    height: 1.95rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.4);
    color: var(--fs-white);
    cursor: pointer;
    padding: 0;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.4s ease,
      border-color 0.4s ease,
      color 0.4s ease;
  }

  .card__toggle svg {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card__toggle:hover {
    background: rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.65);
  }

  .card--open .card__toggle {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.45);
    color: var(--fs-white);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .card--open .card__toggle:hover {
    background: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.65);
  }

  .card--open .card__toggle svg {
    transform: rotate(180deg);
  }

  /* ============================================================
     CONTENIDO COLAPSABLE
     ============================================================ */
  .card__content {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease,
      margin-top 0.35s ease;
    margin-top: 0;
    text-align: left;
  }

  .card--open .card__content {
    max-height: 2000px;
    opacity: 1;
    margin-top: 1rem;
  }

  /* Descripción */
  .card__desc {
    font-family: var(--font-body);
    font-size: 1.02rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.96);
    margin: 0;
    max-width: 100%;
    text-align: left;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.55);
