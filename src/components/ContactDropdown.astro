---
// src/components/ContactDropdown.astro
const links = [
  {
    id: 'whatsapp',
    href: 'https://wa.me/50241080263',
    label: 'WhatsApp',
    external: true,
  },
  {
    id: 'gmail',
    href: 'mailto:fullsolution001@gmail.com',
    label: 'Gmail',
    external: false,
  },
  {
    id: 'facebook',
    href: 'https://www.facebook.com/people/Fullsolution-Gt/pfbid031XL1kRyrCVpH1ccsTbyDk9gNrCxADrns4UfuZxaVeVqEFwdcAwXo94okCHRpw6AHl/?mibextid=wwXIfr&rdid=apzeCE2AfHgr4zBv&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F19SU23Fyac%2F%3Fmibextid%3DwwXIfr',
    label: 'Facebook',
    external: true,
  },
  {
    id: 'instagram',
    href: 'https://www.instagram.com/fullsolution_gt/',
    label: 'Instagram',
    external: true,
  },
  {
    id: 'tiktok',
    href: 'https://www.tiktok.com/@full.solution_gt?_r=1&_t=ZS-99vHFqEJWR2',
    label: 'TikTok',
    external: true,
  },
];
---

<div
  class="contact-dropdown"
  id="contactDropdown"
  hidden
  role="menu"
  aria-label="Canales de contacto"
>
  {links.map((l) => (
    <a
      href={l.href}
      class="contact-dropdown__item"
      role="menuitem"
      target={l.external ? '_blank' : undefined}
      rel={l.external ? 'noopener noreferrer' : undefined}
      data-channel={l.id}
    >
      {l.label}
    </a>
  ))}
</div>

<style>
  /* ============================================================
     CONTENEDOR — igual al .megamenu del Header
     ============================================================ */
  .contact-dropdown {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1000;

    min-width: 200px;
    padding: 1rem 1.1rem;

    background: #ffffff;
    border-top: 2px solid #2ba7f0;
    border-radius: 10px;
    box-shadow: 0 18px 48px rgba(11, 31, 51, 0.16);

    display: flex;
    flex-direction: column;
    gap: 0.45rem;

    opacity: 0;
    transform: translate(-50%, 8px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }

  .contact-dropdown:not([hidden]) {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .contact-dropdown[hidden] { display: none !important; }

  /* ============================================================
     OPCIONES — idénticas a .megamenu__list a (texto plano)
     ============================================================ */
  .contact-dropdown__item {
    display: block;
    font-family: var(--font-body, system-ui, sans-serif);
    font-size: 0.86rem;
    line-height: 1.3;
    color: #37475a;
    padding: 0.1rem 0;
    text-decoration: none;
    transition: padding 0.2s ease, color 0.2s ease;
  }

  .contact-dropdown__item:hover {
    color: #2ba7f0;
    padding-left: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-dropdown,
    .contact-dropdown__item {
      transition: none !important;
    }
  }
</style>