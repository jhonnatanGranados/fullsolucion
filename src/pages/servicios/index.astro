---
// src/pages/servicios/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Card from '../../components/Card.astro';
import { servicios } from '../../data/servicios';

const categorias = [
  { id: 'electrico',            label: 'Eléctrico'            },
  { id: 'energia-redes',        label: 'Energía y redes'      },
  { id: 'industrial',           label: 'Industrial'           },
  { id: 'construccion-liviana', label: 'Construcción liviana' },
  { id: 'complementarios',      label: 'Complementarios'      },
] as const;

const serviciosPorCategoria = categorias.map((cat) => ({
  ...cat,
  items: servicios.filter((s) => s.category === cat.id),
}));
---

<Layout
  title="Servicios | Full Solution"
  description="16 servicios técnicos en Guatemala: electricidad, energías renovables, automatización industrial, construcción liviana y servicios complementarios. Personal calificado y materiales certificados."
>
  <Header slot="header" />

  <main class="servicios-page">
    <section class="servicios-hero">
      <span class="servicios-hero__kicker">Catálogo completo</span>
      <h1>16 servicios técnicos, una sola empresa</h1>
      <p>
        Electricidad, energías renovables, automatización industrial, construcción
        liviana y servicios complementarios. Ejecutados con personal calificado y
        materiales certificados en toda Guatemala.
      </p>

      <button
        type="button"
        class="servicios-hero__menu-btn"
        data-servicios-menu-trigger
        aria-expanded="false"
        aria-controls="servicios-menu"
      >
        Ver menú de servicios
      </button>
    </section>

    <section class="servicios-grid" aria-label="Listado completo de servicios">
      {servicios.map((s) => (
        <div id={s.slug} class="servicio-anchor">
          <Card
            title={s.title}
            subtitle={s.subtitle}
            description={s.description}
            icon={s.icon}
            refCode={s.ref}
            items={s.items}
            image={s.image}
            imageAlt={s.imageAlt}
          />
        </div>
      ))}
    </section>
  </main>

  <div class="servicios-menu" id="servicios-menu" data-servicios-menu hidden>
    <div class="servicios-menu__backdrop" data-servicios-menu-close></div>

    <div
      class="servicios-menu__sheet"
      role="dialog"
      aria-modal="true"
      aria-labelledby="servicios-menu-title"
    >
      <div class="servicios-menu__handle" aria-hidden="true"></div>

      <header class="servicios-menu__head">
        <h2 id="servicios-menu-title">Servicios</h2>
        <button
          type="button"
          class="servicios-menu__close"
          data-servicios-menu-close
          aria-label="Cerrar menú"
        >✕</button>
      </header>

      <div class="servicios-menu__body">
        {serviciosPorCategoria.map((cat) => (
          <section class="servicios-menu__group" data-categoria={cat.id}>
            <h3 class="servicios-menu__group-title">{cat.label}</h3>

            <ul class="servicios-menu__list">
              {cat.items.map((s) => (
                <li>
                  <a
                    href={`#${s.slug}`}
                    class="servicios-menu__item"
                    data-servicios-menu-item
                    data-slug={s.slug}
                  >
                    <span class="servicios-menu__item-text">
                      <strong>{s.title}</strong>
                    </span>
                    <span class="servicios-menu__item-arrow" aria-hidden="true">›</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>

  <Footer slot="footer" />

  <script>
    let serviciosInit = false;

    function abrirPorHash() {
      const hash = window.location.hash.replace('#', '');
      if (!hash) return;

      const target = document.getElementById(hash);
      if (!target) return;

      const card = target.querySelector('.card');
      if (!card) return;

      document.querySelectorAll('.card--open').forEach((c) => {
        c.classList.remove('card--open');
        c.querySelector('.card__toggle')?.setAttribute('aria-expanded', 'false');
        const p = c.querySelector('.card__items');
        if (p) (p as HTMLElement).hidden = true;
      });

      card.classList.add('card--open');
      card.querySelector('.card__toggle')?.setAttribute('aria-expanded', 'true');
      const itemsPanel = card.querySelector('.card__items');
      if (itemsPanel) (itemsPanel as HTMLElement).hidden = false;

      requestAnimationFrame(() => {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    function initServicios() {
      if (serviciosInit) return;
      serviciosInit = true;

      const tieneHash = !!window.location.hash;

      if (tieneHash) {
        abrirPorHash();
      } else {
        window.scrollTo(0, 0);
      }

      window.addEventListener('hashchange', abrirPorHash);

      const menu      = document.querySelector<HTMLElement>('[data-servicios-menu]');
      const trigger   = document.querySelector<HTMLButtonElement>('[data-servicios-menu-trigger]');
      const closers   = document.querySelectorAll<HTMLElement>('[data-servicios-menu-close]');
      const menuItems = document.querySelectorAll<HTMLAnchorElement>('[data-servicios-menu-item]');

      let lastFocus: HTMLElement | null = null;

      const openMenu = () => {
        if (!menu) return;
        lastFocus = document.activeElement as HTMLElement;
        menu.hidden = false;
        document.body.style.overflow = 'hidden';
        trigger?.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(() => {
          menu.querySelector<HTMLElement>('.servicios-menu__close')?.focus();
        });
      };

      const closeMenu = () => {
        if (!menu) return;
        menu.hidden = true;
        document.body.style.overflow = '';
        trigger?.setAttribute('aria-expanded', 'false');
        lastFocus?.focus();
      };

      trigger?.addEventListener('click', openMenu);
      closers.forEach((el) => el.addEventListener('click', closeMenu));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu && !menu.hidden) closeMenu();
      });

      menuItems.forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const slug = link.dataset.slug;
          if (!slug) return;
          closeMenu();
          history.pushState(null, '', `#${slug}`);
          abrirPorHash();
        });
      });

      const sheet = document.querySelector<HTMLElement>('.servicios-menu__sheet');
      if (sheet) {
        let startY = 0;
        let currentY = 0;
        let dragging = false;

        sheet.addEventListener('touchstart', (e: TouchEvent) => {
          if (sheet.scrollTop > 0) return;
          startY = currentY = e.touches[0].clientY;
          dragging = true;
          sheet.style.transition = 'none';
        }, { passive: true });

        sheet.addEventListener('touchmove', (e: TouchEvent) => {
          if (!dragging) return;
          currentY = e.touches[0].clientY;
          const delta = currentY - startY;
          if (delta > 0) sheet.style.transform = `translateY(${delta}px)`;
        }, { passive: true });

        sheet.addEventListener('touchend', () => {
          if (!dragging) return;
          dragging = false;
          sheet.style.transition = '';
          if (currentY - startY > 120) closeMenu();
          sheet.style.transform = '';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initServicios);
    } else {
      initServicios();
    }

    document.addEventListener('astro:page-load', initServicios);
  </script>

  <style>
    .servicios-page { background: #ffffff; min-height: 100vh; padding-bottom: 4rem; }

    .servicios-hero {
      max-width: 900px;
      margin: 0 auto;
      padding: 3.5rem clamp(1.25rem, 4vw, 2.5rem) 2rem;
      text-align: center;
    }
    .servicios-hero__kicker {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--fs-highlight);
      margin-bottom: 0.9rem;
    }
    .servicios-hero h1 {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3.2vw, 2.6rem);
      font-weight: 800;
      color: #0f1730;
      margin: 0 0 1rem;
      letter-spacing: -0.02em;
      line-height: 1.15;
    }
    .servicios-hero p {
      font-family: var(--font-body);
      font-size: 1.02rem;
      line-height: 1.7;
      color: rgba(15, 23, 48, 0.75);
      margin: 0;
    }
    .servicios-hero__menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1.5rem;
      padding: 0.85rem 1.5rem;
      border: none;
      border-radius: 999px;
      background: linear-gradient(135deg, #0A4BD3, #107bcd);
      color: #ffffff;
      font-family: var(--font-display, system-ui, sans-serif);
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      cursor: pointer;
      box-shadow: 0 8px 24px -8px rgba(10, 75, 211, 0.5);
      transition: transform 0.15s ease, filter 0.2s ease;
    }
    .servicios-hero__menu-btn:hover  { filter: brightness(1.08); }
    .servicios-hero__menu-btn:active { transform: scale(0.97); }

    .servicios-grid {
      max-width: 1280px;
      margin: 0 auto;
      padding: 1rem clamp(1.25rem, 4vw, 2.5rem) 4rem;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.2rem;
    }
    .servicio-anchor { scroll-margin-top: 130px; }

    .servicios-menu {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }
    .servicios-menu[hidden] { display: none !important; }

    .servicios-menu__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(11, 15, 26, 0.55);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      animation: menuFadeIn 0.25s ease-out;
    }
    .servicios-menu__sheet {
      position: relative;
      width: 100%;
      max-height: 88dvh;
      background: #ffffff;
      border-radius: 24px 24px 0 0;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      overscroll-behavior: contain;
      animation: sheetSlideUp 0.32s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 -12px 40px -12px rgba(0, 0, 0, 0.35);
      touch-action: pan-y;
      will-change: transform;
    }
    .servicios-menu__handle {
      flex: 0 0 auto;
      width: 44px;
      height: 5px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.18);
      margin: 0.7rem auto 0.4rem;
    }
    .servicios-menu__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.4rem 1.25rem 0.9rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
      position: sticky;
      top: 0;
      background: #ffffff;
      z-index: 2;
    }
    .servicios-menu__head h2 {
      font-family: var(--font-display, system-ui, sans-serif);
      font-size: 1.15rem;
      font-weight: 800;
      color: #0b0f1a;
      margin: 0;
    }
    .servicios-menu__close {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.06);
      border: none;
      font-size: 1.05rem;
      font-weight: 700;
      color: #0b0f1a;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .servicios-menu__body {
      padding: 0.5rem 1rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .servicios-menu__group-title {
      font-family: var(--font-mono, monospace);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #0A4BD3;
      margin: 0 0 0.5rem 0.25rem;
    }
    .servicios-menu__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .servicios-menu__item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.85rem 1rem;
      background: linear-gradient(145deg, #ffffff, #f5f6f8);
      border: 1px solid rgba(0, 0, 0, 0.06);
      border-radius: 14px;
      text-decoration: none;
      color: inherit;
      transition: transform 0.12s ease, background 0.2s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .servicios-menu__item:active {
      transform: scale(0.98);
      background: linear-gradient(145deg, #eef1f6, #e3e7ee);
    }
    .servicios-menu__item-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .servicios-menu__item-text strong {
      font-family: var(--font-display, system-ui, sans-serif);
      font-size: 0.95rem;
      font-weight: 600;
      color: #0b0f1a;
      line-height: 1.3;
    }
    .servicios-menu__item-arrow { font-size: 1.4rem; color: #9aa2b1; line-height: 1; flex: 0 0 auto; }

    @keyframes menuFadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes sheetSlideUp {
      from { transform: translateY(60px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }

    @media (hover: hover) and (pointer: fine) and (min-width: 721px) {
      .servicios-menu { align-items: center; }
      .servicios-menu__sheet {
        max-width: 560px;
        max-height: 80vh;
        border-radius: 24px;
      }
    }

    @media (max-width: 720px), (hover: none) and (pointer: coarse) {
      .servicios-menu__body { padding: 0.5rem 1.25rem 2rem; gap: 1.5rem; }
      .servicios-menu__group-title { font-size: 0.7rem; color: #6b7280; margin: 0 0 0.25rem 0.15rem; }
      .servicios-menu__list {
        gap: 0;
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.07);
      }
      .servicios-menu__item {
        background: #ffffff;
        border: none;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        border-radius: 0;
        padding: 1.05rem 1rem;
        min-height: 56px;
      }
      .servicios-menu__list li:last-child .servicios-menu__item { border-bottom: none; }
      .servicios-menu__item:active { background: #f2f4f8; transform: none; }
      .servicios-menu__item-text strong { font-size: 1rem; }
      .servicios-menu__item-arrow { font-size: 1.1rem; color: #c4c9d2; }
      .servicios-menu__sheet { max-height: 92dvh; border-radius: 20px 20px 0 0; }
      .servicios-menu__head { padding: 0.6rem 1.25rem 1rem; border-bottom: 1px solid rgba(0, 0, 0, 0.08); }
      .servicios-menu__head h2 { font-size: 1.1rem; font-weight: 700; }
      .servicios-menu__close { background: transparent; font-size: 1.25rem; color: #6b7280; }
    }

    @media (max-width: 980px) { .servicios-hero { padding-top: 2.5rem; } }
    @media (max-width: 720px) {
      .servicios-grid { grid-template-columns: 1fr; gap: 0.9rem; }
      .servicio-anchor { scroll-margin-top: 160px; }
      .servicios-hero h1 { font-size: 1.65rem; }
      .servicios-hero p  { font-size: 0.95rem; }
    }

    @supports (padding: max(0px)) {
      .servicios-menu__sheet { padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
    }
  </style>
</Layout>